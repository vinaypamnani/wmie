<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:WmiExplorer.PropertyGrid.Behaviors"
                    xmlns:local="clr-namespace:WmiExplorer.PropertyGrid"
                    xmlns:pgConverters="clr-namespace:WmiExplorer.PropertyGrid.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PropertyGridStyles.xaml" />
        <ResourceDictionary Source="PropertyTreeStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ================================================================  -->
    <!--  CONVERTERS  -->
    <!--  ================================================================  -->
    <pgConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <pgConverters:BoolToVisibilityConverter x:Key="BooleanNotToVisibilityConverter" Invert="True" />
    <pgConverters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />


    <!--  ================================================================  -->
    <!--  TEXTBOX SEARCH BOX STYLE  -->
    <!--  ================================================================  -->
    <Style x:Key="SearchTextBoxStyle" TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PropertyGridBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PropertyGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="26,4,26,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBox with Search Icon, Placeholder, and Clear Button (like TextBoxWithClearButton)  -->
    <Style x:Key="PropertyGridTextBoxWithClearButton" BasedOn="{StaticResource SearchTextBoxStyle}" TargetType="TextBox">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid VerticalAlignment="Center">
                            <!--  Search Icon  -->
                            <Viewbox Width="16"
                                     Height="16"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <Ellipse Canvas.Left="1"
                                             Canvas.Top="2"
                                             Width="10"
                                             Height="10"
                                             Stroke="Gray"
                                             StrokeThickness="2" />
                                    <Line Stroke="Gray"
                                          StrokeThickness="2"
                                          X1="9"
                                          X2="14"
                                          Y1="10"
                                          Y2="15" />
                                </Canvas>
                            </Viewbox>
                            <!--  Text Content  -->
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="24,0,24,0"
                                          Background="Transparent"
                                          Focusable="false" />
                            <!--  Placeholder  -->
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="24,0,24,0"
                                       Padding="0,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                            <!--  Clear Button  -->
                            <Button x:Name="PART_ClearButton"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Command="{Binding ClearSearchCommand, RelativeSource={RelativeSource AncestorType={x:Type local:PropertyGrid}}}"
                                    Cursor="Hand"
                                    Focusable="False"
                                    ToolTip="Clear">
                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                      Stroke="Gray"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Show placeholder and hide clear button if empty or null  -->
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!--  Show clear button only when Text is not empty or null  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="" />
                                <Condition Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  GridSplitter  -->
    <Style x:Key="PropertyGridGridSplitter" TargetType="GridSplitter">
        <Setter Property="Background" Value="{DynamicResource PropertyGridSecondaryBackgroundBrush}" />
        <Setter Property="Width" Value="50" />
        <Setter Property="Height" Value="5" />
        <Setter Property="Margin" Value="5,5,5,5" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ShowsPreview" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource PropertyGridHoverBackgroundBrush}" />
                <Setter Property="Width" Value="Auto" />
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter Property="Background" Value="{DynamicResource PropertyGridHoverBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ================================================================  -->
    <!--  CUSTOM PROPERTY GRID TEMPLATE  -->
    <!--  ================================================================  -->
    <ControlTemplate x:Key="PropertyGridTemplate" TargetType="local:PropertyGrid">
        <Border Padding="5"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <Grid x:Name="PART_MainGrid">
                <Grid.RowDefinitions>
                    <!--  Options row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Search box row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Properties list / tree row  -->
                    <RowDefinition Height="*" />
                    <!--  Grid splitter row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Help text row  -->
                    <RowDefinition Height="{Binding HelpPaneHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" />
                </Grid.RowDefinitions>

                <!--  ===== OPTIONS PANEL (for checkboxes) =====  -->
                <DockPanel Grid.Row="0"
                           Margin="8,8,8,8"
                           LastChildFill="False"
                           Visibility="{Binding ShowOptions, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <CheckBox Content="Show null values" IsChecked="{Binding IncludeNullValues, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <CheckBox Margin="8,0,0,0" Content="Show System Properties" IsChecked="{Binding IncludeSystemProperties, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                    <!--  Add more options here as needed  -->
                </DockPanel>

                <!--  ===== SEARCH BOX =====  -->
                <Grid Grid.Row="1" Margin="8,8,8,4" Visibility="{Binding ShowSearchBox, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  TextBoxWithClearButton for Search (icon and clear integrated)  -->
                    <TextBox x:Name="PART_SearchBox"
                             MinWidth="80"
                             Margin="0"
                             Padding="4,4,4,4"
                             VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource PropertyGridForegroundBrush}"
                             FontSize="13"
                             Foreground="{DynamicResource PropertyGridForegroundBrush}"
                             Style="{StaticResource PropertyGridTextBoxWithClearButton}"
                             Tag="Filter properties..."
                             ToolTip="Filter properties by name or description" />
                </Grid>

                <!--  ===== PROPERTIES CONTENT =====  -->
                <Grid Grid.Row="2" Background="{DynamicResource PropertyGridBackgroundBrush}">

                    <!--  TreeView Mode  -->
                    <ScrollViewer x:Name="PART_TreeScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <TreeView x:Name="PART_PropertiesTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.CanContentScroll="False"
                                  VirtualizingStackPanel.IsVirtualizing="{Binding EnableVirtualization, RelativeSource={RelativeSource TemplatedParent}}"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">

                            <TreeView.Resources>
                                <!--  Ensure all items stretch horizontally  -->
                                <Style TargetType="DockPanel">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemTemplateSelector>
                                <local:PropertyItemTemplateSelector CategoryItemTemplate="{StaticResource CategoryItemTemplate}" PropertyItemTemplate="{StaticResource PropertyItemTemplate}" />
                            </TreeView.ItemTemplateSelector>
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource PropertyTreeViewItemStyle}" TargetType="TreeViewItem">
                                    <Setter Property="behaviors:SuppressRequestBringIntoViewBehavior.SuppressBringIntoView" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="True" />
                                    <Setter Property="Margin" Value="0" />

                                    <!--  Bind the TreeViewItem's Visibility to the model's Visibility property  -->
                                    <Setter Property="Visibility" Value="{Binding Visibility, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </ScrollViewer>
                </Grid>

                <!--  ===== SPLITTER =====  -->
                <GridSplitter x:Name="PART_GridSplitter"
                              Grid.Row="3"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Focusable="False"
                              Style="{StaticResource PropertyGridGridSplitter}"
                              Visibility="{Binding ShowHelpPane, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  ===== HELP PANE =====  -->
                <Border Grid.Row="4"
                        Background="{DynamicResource PropertyGridBackgroundBrush}"
                        BorderBrush="{DynamicResource PropertyGridBorderBrush}"
                        BorderThickness="1,1,1,1"
                        Visibility="{Binding ShowHelpPane, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="8" VerticalAlignment="Top">
                            <TextBlock FontWeight="Bold" Foreground="{DynamicResource PropertyGridForegroundBrush}" Text="{Binding SelectedHierarchyItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource PropertyGridForegroundBrush}"
                                     Foreground="{DynamicResource PropertyGridForegroundBrush}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Text="{Binding SelectedHierarchyItem.Description, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Select a property to view its description.'}"
                                     TextWrapping="Wrap">
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{x:Static local:PropertyGrid.HelpPaneCopyCommand}" Header="Copy" />
                                        <MenuItem Command="{x:Static local:PropertyGrid.HelpPaneSelectAllCommand}" Header="Select All" />
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ================================================================  -->
    <!--  CUSTOM PROPERTY GRID STYLE  -->
    <!--  ================================================================  -->
    <Style TargetType="{x:Type local:PropertyGrid}">
        <Setter Property="Background" Value="{DynamicResource PropertyGridBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PropertyGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource PropertyGridTemplate}" />
    </Style>

</ResourceDictionary>
