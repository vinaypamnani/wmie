<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:WmiExplorer.PropertyGrid.Behaviors"
                    xmlns:local="clr-namespace:WmiExplorer.PropertyGrid"
                    xmlns:pgConverters="clr-namespace:WmiExplorer.PropertyGrid.Converters">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PropertyGridStyles.xaml" />
        <ResourceDictionary Source="PropertyTreeStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  ================================================================  -->
    <!--  CONVERTERS  -->
    <!--  ================================================================  -->
    <pgConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <pgConverters:BoolToVisibilityConverter x:Key="BooleanNotToVisibilityConverter" Invert="True" />
    <pgConverters:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />

    <!--  ================================================================  -->
    <!--  CUSTOM PROPERTY GRID TEMPLATE  -->
    <!--  ================================================================  -->
    <ControlTemplate x:Key="PropertyGridTemplate" TargetType="local:PropertyGrid">
        <Border Padding="4"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}">
            <Grid x:Name="PART_MainGrid">
                <Grid.RowDefinitions>
                    <!--  Options row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Search box row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Properties list / tree row  -->
                    <RowDefinition Height="*" />
                    <!--  Grid splitter row  -->
                    <RowDefinition Height="Auto" />
                    <!--  Help text row  -->
                    <RowDefinition Height="{Binding HelpPaneHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, Converter={StaticResource DoubleToGridLengthConverter}}" />
                </Grid.RowDefinitions>
                <!--  ===== OPTIONS PANEL (for checkboxes and slider) =====  -->
                <StackPanel Grid.Row="0" Margin="0,4" Orientation="Vertical">

                    <!--  Top row: Checkboxes  -->
                    <StackPanel Orientation="Horizontal">
                        <!--  ShowOptions checkboxes - Using FilterOptions for cleaner property management  -->
                        <StackPanel Orientation="Horizontal" Visibility="{Binding ShowOptions, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox Margin="0,0,0,0" Content="Show null values" IsChecked="{Binding FilterOptions.IncludeNullValues, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                            <CheckBox Margin="4,0,0,0" Content="Show read-only properties" IsChecked="{Binding FilterOptions.IncludeReadOnlyProperties, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </StackPanel>

                        <!--  ShowWmiOptions checkboxes - Using FilterOptions for cleaner property management  -->
                        <StackPanel Margin="4,0,0,0" Orientation="Horizontal" Visibility="{Binding ShowWmiOptions, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                            <CheckBox Content="Show System Properties" IsChecked="{Binding FilterOptions.IncludeSystemProperties, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        </StackPanel>
                    </StackPanel>

                    <!--  Bottom row: Column Width Slider  -->
                    <StackPanel Margin="0,4,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                        <TextBlock Margin="0,0,4,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PropertyGridForegroundBrush}"
                                   Text="Name Width:" />
                        <Slider Width="100"
                                VerticalAlignment="Center"
                                Maximum="400"
                                Minimum="100"
                                Style="{StaticResource PropertyGridSliderStyle}"
                                ToolTip="Adjust property name column width"
                                Value="{Binding NameColumnWidth, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                        <TextBlock Margin="4,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PropertyGridForegroundBrush}"
                                   Text="{Binding NameColumnWidth, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0:F0}}" />
                    </StackPanel>

                </StackPanel>

                <!--  ===== SEARCH BOX =====  -->
                <Grid Grid.Row="1" Margin="0,4" Visibility="{Binding ShowSearchBox, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  TextBoxWithClearButton for Search (icon and clear integrated)  -->
                    <TextBox x:Name="PART_SearchBox"
                             MinWidth="80"
                             Margin="0"
                             Padding="4,4,4,4"
                             VerticalContentAlignment="Center"
                             CaretBrush="{DynamicResource PropertyGridForegroundBrush}"
                             FontSize="13"
                             Foreground="{DynamicResource PropertyGridForegroundBrush}"
                             Style="{StaticResource PropertyGridTextBoxWithClearButton}"
                             Tag="Filter properties..."
                             ToolTip="Filter properties by name or description" />
                </Grid>

                <!--  ===== PROPERTIES CONTENT =====  -->
                <Grid Grid.Row="2" Background="{DynamicResource PropertyGridBackgroundBrush}">

                    <!--  TreeView Mode  -->
                    <ScrollViewer x:Name="PART_TreeScrollViewer"
                                  Grid.Row="1"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Visible">
                        <TreeView x:Name="PART_PropertiesTree"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  ScrollViewer.CanContentScroll="False"
                                  VirtualizingStackPanel.IsVirtualizing="{Binding EnableVirtualization, RelativeSource={RelativeSource TemplatedParent}}"
                                  VirtualizingStackPanel.VirtualizationMode="Recycling">

                            <TreeView.Resources>
                                <!--  Ensure all items stretch horizontally  -->
                                <Style TargetType="DockPanel">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                                <Style TargetType="Border">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                                <Style TargetType="Grid">
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                </Style>
                            </TreeView.Resources>
                            <TreeView.ItemTemplateSelector>
                                <local:PropertyItemTemplateSelector CategoryItemTemplate="{StaticResource CategoryItemTemplate}" PropertyEditorCardTemplate="{StaticResource PropertyEditorCardTemplate}" PropertyItemTemplate="{StaticResource PropertyItemTemplate}" />
                            </TreeView.ItemTemplateSelector>
                            <TreeView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource PropertyTreeViewItemStyle}" TargetType="TreeViewItem">
                                    <Setter Property="behaviors:SuppressRequestBringIntoViewBehavior.SuppressBringIntoView" Value="True" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="HorizontalAlignment" Value="Stretch" />
                                    <Setter Property="Focusable" Value="True" />
                                    <Setter Property="Margin" Value="0" />

                                    <!--  Bind the TreeViewItem's Visibility to the model's Visibility property  -->
                                    <Setter Property="Visibility" Value="{Binding Visibility, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                        </TreeView>
                    </ScrollViewer>
                </Grid>

                <!--  ===== SPLITTER =====  -->
                <GridSplitter x:Name="PART_GridSplitter"
                              Grid.Row="3"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Center"
                              Focusable="False"
                              Style="{StaticResource PropertyGridGridSplitter}"
                              Visibility="{Binding ShowHelpPane, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                <!--  ===== HELP PANE =====  -->
                <Border Grid.Row="4"
                        Background="{DynamicResource PropertyGridBackgroundBrush}"
                        BorderBrush="{DynamicResource PropertyGridBorderBrush}"
                        BorderThickness="0"
                        Visibility="{Binding ShowHelpPane, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,4" VerticalAlignment="Top">
                            <TextBlock FontWeight="Bold" Foreground="{DynamicResource PropertyGridForegroundBrush}" Text="{Binding SelectedHierarchyItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBox Background="Transparent"
                                     BorderThickness="0"
                                     CaretBrush="{DynamicResource PropertyGridForegroundBrush}"
                                     Foreground="{DynamicResource PropertyGridForegroundBrush}"
                                     IsReadOnly="True"
                                     IsTabStop="False"
                                     Text="{Binding SelectedHierarchyItem.Description, RelativeSource={RelativeSource TemplatedParent}, TargetNullValue='Select a property to view its description.'}"
                                     TextWrapping="Wrap">
                                <TextBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{x:Static local:PropertyGrid.HelpPaneCopyCommand}" Header="Copy">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource PropertyGridIconStyle}" Text="&#xE8C8;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Command="{x:Static local:PropertyGrid.HelpPaneSelectAllCommand}" Header="Select All">
                                            <MenuItem.Icon>
                                                <TextBlock Style="{StaticResource PropertyGridIconStyle}" Text="&#xE8B3;" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </TextBox.ContextMenu>
                            </TextBox>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </ControlTemplate>

    <!--  ================================================================  -->
    <!--  CUSTOM PROPERTY GRID STYLE  -->
    <!--  ================================================================  -->
    <Style TargetType="{x:Type local:PropertyGrid}">
        <Setter Property="Background" Value="{DynamicResource PropertyGridBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PropertyGridBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinWidth" Value="200" />
        <Setter Property="MinHeight" Value="150" />
        <Setter Property="Template" Value="{StaticResource PropertyGridTemplate}" />
    </Style>

</ResourceDictionary>
