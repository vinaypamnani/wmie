<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Status Indicator Style  -->
    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource SpacingSmall}" />
        <Setter Property="Height" Value="{StaticResource SpacingSmall}" />
        <Setter Property="Margin" Value="{StaticResource MarginTiny}" />
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LoadState}" Value="Loading">
                <Setter Property="Fill" Value="{DynamicResource BusyBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Success">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Warning">
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Letter Icon Template for reusable icon indicators  -->
    <ControlTemplate x:Key="LetterIconTemplate" TargetType="ContentControl">
        <Grid Width="16" Height="16">
            <Rectangle Fill="{TemplateBinding Background}"
                       Stroke="Transparent"
                       StrokeThickness="0.5"
                       RadiusX="2"
                       RadiusY="2"/>

            <TextBlock Text="{TemplateBinding Content}"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{TemplateBinding Foreground}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Grid>
    </ControlTemplate>
</ResourceDictionary>
