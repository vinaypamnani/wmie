<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Status Indicator Style  -->
    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{StaticResource SpacingSmall}" />
        <Setter Property="Height" Value="{StaticResource SpacingSmall}" />
        <Setter Property="Margin" Value="{StaticResource MarginTiny}" />
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LoadState}" Value="Loading">
                <Setter Property="Fill" Value="{DynamicResource BusyBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Success">
                <Setter Property="Fill" Value="{DynamicResource SuccessBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Warning">
                <Setter Property="Fill" Value="{DynamicResource WarningBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource ErrorBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
