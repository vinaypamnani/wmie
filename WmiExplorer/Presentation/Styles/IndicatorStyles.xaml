<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Status Indicator Style  -->
    <Style x:Key="StatusIndicatorStyle" TargetType="Ellipse">
        <Setter Property="Width" Value="{DynamicResource SpacingSmall}" />
        <Setter Property="Height" Value="{DynamicResource SpacingSmall}" />
        <Setter Property="Margin" Value="{DynamicResource MarginRightMedium}" />
        <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding LoadState}" Value="Loading">
                <Setter Property="Fill" Value="{DynamicResource BaseBlueBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Success">
                <Setter Property="Fill" Value="{DynamicResource BaseGreenBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Warning">
                <Setter Property="Fill" Value="{DynamicResource BaseOrangeBrush}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding LoadState}" Value="Failed">
                <Setter Property="Fill" Value="{DynamicResource BaseRedBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Letter Icon Template for reusable icon indicators  -->
    <ControlTemplate x:Key="LetterIconTemplate" TargetType="ContentControl">
        <Border Width="16"
                Height="16"
                Background="{TemplateBinding Background}"
                CornerRadius="2">
            <!--  Uses PrimaryBackgroundBrush for Foreground intentionally to inverse for better contrast  -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontFamily="Segoe UI"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryBackgroundBrush}"
                       Text="{TemplateBinding Content}" />
        </Border>
    </ControlTemplate>
</ResourceDictionary>
