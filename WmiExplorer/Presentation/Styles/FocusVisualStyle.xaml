<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Disable focus for all content controls  -->
    <!--  This is needed to prevent focus from being set on content controls that are not focusable  -->
    <!--  If we need a focusable ContentControl, we can create a new style and use it explicitly  -->
    <Style TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!--  Compact focus visual style  -->
    <Style x:Key="CompactFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border BorderBrush="{DynamicResource FocusedElementBrush}" BorderThickness="1" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Cozy focus visual style  -->
    <Style x:Key="CozyFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4"
                            BorderBrush="{DynamicResource FocusedElementBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Horizontal cozy focus visual style  -->
    <Style x:Key="HorizontalCozyFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-4,-2,-4,-2"
                            BorderBrush="{DynamicResource FocusedElementBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Vertical cozy focus visual style  -->
    <Style x:Key="VerticalCozyFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2,-4,-2,-4"
                            BorderBrush="{DynamicResource FocusedElementBrush}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
