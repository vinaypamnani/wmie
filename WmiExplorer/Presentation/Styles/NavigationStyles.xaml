<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  TabControl  -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="BorderThickness" Value="0,4,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid ClipToBounds="True" KeyboardNavigation.TabNavigation="Local" SnapsToDevicePixels="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Name="ColumnDefinition0" />
                            <ColumnDefinition Name="ColumnDefinition1" Width="0" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Name="RowDefinition0" Height="Auto" />
                            <RowDefinition Name="RowDefinition1" Height="*" />
                        </Grid.RowDefinitions>
                        <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="0">
                            <TabPanel Name="HeaderPanel"
                                      Grid.Row="0"
                                      Grid.Column="0"
                                      Panel.ZIndex="1"
                                      IsItemsHost="True"
                                      KeyboardNavigation.TabIndex="1" />
                        </Border>
                        <Grid Name="ContentPanel"
                              Grid.Row="1"
                              Grid.Column="0"
                              KeyboardNavigation.DirectionalNavigation="Contained"
                              KeyboardNavigation.TabIndex="2"
                              KeyboardNavigation.TabNavigation="Local">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="0">
                                <ContentPresenter Name="PART_SelectedContentHost"
                                                  Margin="0,4,0,0"
                                                  Content="{TemplateBinding SelectedContent}"
                                                  ContentSource="SelectedContent"
                                                  ContentStringFormat="{TemplateBinding SelectedContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding SelectedContentTemplate}"
                                                  SnapsToDevicePixels="True" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabControl.TabStripPlacement" Value="Bottom">
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                            <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="Auto" />
                            <Setter TargetName="HeaderBorder" Property="FrameworkElement.Margin" Value="0,5,0,0" />
                        </Trigger>
                        <Trigger Property="TabControl.TabStripPlacement" Value="Left">
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="Auto" />
                            <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="*" />
                            <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                            <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                            <Setter TargetName="HeaderBorder" Property="FrameworkElement.Margin" Value="0,0,5,0" />
                        </Trigger>
                        <Trigger Property="TabControl.TabStripPlacement" Value="Right">
                            <Setter TargetName="HeaderPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                            <Setter TargetName="HeaderPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ColumnDefinition0" Property="ColumnDefinition.Width" Value="*" />
                            <Setter TargetName="ColumnDefinition1" Property="ColumnDefinition.Width" Value="Auto" />
                            <Setter TargetName="RowDefinition0" Property="RowDefinition.Height" Value="*" />
                            <Setter TargetName="RowDefinition1" Property="RowDefinition.Height" Value="0" />
                            <Setter TargetName="HeaderBorder" Property="FrameworkElement.Margin" Value="5,0,0,0" />
                        </Trigger>
                        <Trigger Property="UIElement.IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TabItem  -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd"
                            Margin="0,0,4,0"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="0">
                        <ContentPresenter x:Name="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Selected Tab Style  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
                            <!-- <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelectedItemBackgroundBrush}" /> -->
                        </Trigger>
                        <!--  Disabled Tab Style  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                            <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                            <Setter Property="FontStyle" Value="Italic" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CompactFocusVisualStyle}" />
    </Style>

    <!--  ToggleButton Style for Vertical Expander with Chevron Arrows  -->
    <Style x:Key="VerticalExpanderToggleStyle" TargetType="ToggleButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ToggleBorder"
                            Width="22"
                            Height="22"
                            Background="Transparent"
                            BorderBrush="{DynamicResource SecondaryForegroundBrush}"
                            BorderThickness="0.5"
                            CornerRadius="1">
                        <!--  Chevron arrow similar to SortArrow  -->
                        <Path x:Name="ExpanderArrow"
                              Width="14"
                              Height="14"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Fill="{DynamicResource SecondaryAccentBrush}"
                              Stretch="Uniform"
                              Stroke="{DynamicResource SecondaryAccentBrush}"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              StrokeStartLineCap="Round"
                              StrokeThickness="1">
                            <!--  Default chevron pointing right  -->
                            <Path.Data>M 0,0 L 5,5 L 0,10</Path.Data>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!--  Right direction (default) unchecked  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="False" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Right" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ExpanderArrow" Property="Data" Value="M 0,0 L 5,5 L 0,10" />
                        </MultiDataTrigger>

                        <!--  Right direction checked - collapsed arrow  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Right" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ExpanderArrow" Property="Data" Value="M 5,0 L 0,5 L 5,10" />
                        </MultiDataTrigger>

                        <!--  Left direction default - left pointing arrow  -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left">
                            <Setter TargetName="ExpanderArrow" Property="Data" Value="M 5,0 L 0,5 L 5,10" />
                        </DataTrigger>

                        <!--  Left direction checked - expanded arrow  -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Left" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ExpanderArrow" Property="Data" Value="M 0,0 L 5,5 L 0,10" />
                        </MultiDataTrigger>

                        <!--  IsExpanded based Arrow fill  -->
                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
                            <Setter TargetName="ExpanderArrow" Property="Stroke" Value="{DynamicResource SecondaryForegroundBrush}" />
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource TertiaryForegroundBrush}" />
                        </DataTrigger>


                        <!--  Hover effect with improved visuals  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ExpanderArrow" Property="Fill" Value="{DynamicResource SecondaryAccentBrush}" />
                            <Setter TargetName="ExpanderArrow" Property="Stroke" Value="{DynamicResource SecondaryAccentBrush}" />
                            <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}" />
                            <Setter TargetName="ToggleBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ToggleBorder" Property="CornerRadius" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{StaticResource CozyFocusVisualStyle}" />
    </Style>

    <!--  Expander - Collapsible panel style with vertical header  -->
    <Style x:Key="VerticalHeaderExpanderStyle" TargetType="Expander">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="MinWidth" Value="30" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <!--  Add HeaderTemplate for consistent header styling  -->
        <Setter Property="HeaderTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Border Width="25">
                        <TextBlock Style="{StaticResource ExpanderTextBlockStyle}" Text="{Binding}" />
                    </Border>
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="LeftColumn" Width="Auto" />
                            <ColumnDefinition x:Name="RightColumn" Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Header - Position determined by ExpandDirection  -->
                        <Border x:Name="HeaderBorder"
                                Grid.Column="0"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="0">

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  Toggle Button at Top  -->
                                <ToggleButton x:Name="ExpanderButton"
                                              Grid.Row="0"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="Center"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Style="{StaticResource VerticalExpanderToggleStyle}"
                                              Tag="Right" />

                                <!--  Vertical Header Content  -->
                                <ContentPresenter x:Name="HeaderContent"
                                                  Grid.Row="1"
                                                  MinWidth="30"
                                                  Margin="2,8,2,8"
                                                  ContentSource="Header" />
                            </Grid>
                        </Border>

                        <!--  Content - Position determined by ExpandDirection  -->
                        <Border x:Name="ContentBorder"
                                Grid.Column="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0"
                                Visibility="Collapsed">
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!--  IsExpanded Triggers  -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpanderButton" Property="ToolTip" Value="Collapse" />
                            <Setter TargetName="ContentBorder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                        </Trigger>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="ExpanderButton" Property="ToolTip" Value="Expand" />
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                            <Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                            <!-- <Setter TargetName="HeaderBorder" Property="Margin" Value="0,4,0,4" /> -->
                        </Trigger>

                        <!--  ExpandDirection Triggers  -->
                        <Trigger Property="ExpandDirection" Value="Right">
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ExpanderButton" Property="Tag" Value="Right" />
                            <Setter TargetName="HeaderBorder" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderBorder" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="HeaderContent" Property="HorizontalAlignment" Value="Center" />
                        </Trigger>

                        <Trigger Property="ExpandDirection" Value="Left">
                            <Setter TargetName="HeaderBorder" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ContentBorder" Property="Grid.Column" Value="0" />
                            <Setter TargetName="ContentBorder" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="ContentBorder" Property="Width" Value="Auto" />
                            <Setter TargetName="ExpanderButton" Property="Tag" Value="Left" />
                            <Setter TargetName="HeaderBorder" Property="Width" Value="Auto" />
                            <Setter TargetName="HeaderBorder" Property="MinWidth" Value="30" />
                            <Setter TargetName="HeaderBorder" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="HeaderContent" Property="HorizontalAlignment" Value="Center" />
                            <!--  Fix for content space in left direction  -->
                            <Setter TargetName="LeftColumn" Property="Width" Value="*" />
                            <Setter TargetName="RightColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="ContentSite" Property="HorizontalAlignment" Value="Stretch" />
                        </Trigger>

                        <!--  IsExpanded False triggers based on ExpandDirection  -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="ExpandDirection" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="0,2,2,2" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="0,3,3,0" />
                        </MultiTrigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsExpanded" Value="False" />
                                <Condition Property="ExpandDirection" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBorder" Property="BorderThickness" Value="2,2,0,2" />
                            <Setter TargetName="HeaderBorder" Property="CornerRadius" Value="3,0,0,3" />
                            <!--  Workaround for not being able to/wanting to set Margin on outer GridSplitter or else the MouseOver on button doesn't have Left Margin  -->
                            <Setter TargetName="HeaderBorder" Property="Margin" Value="4,0,0,0" />
                        </MultiTrigger>

                        <!--  Mouse over on Button  -->
                        <Trigger SourceName="ExpanderButton" Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Name="HoverDelayStoryboard" Storyboard="{StaticResource HoverDelayStoryboard}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="HoverDelayStoryboard" />
                                <BeginStoryboard Storyboard="{StaticResource HoverResetStoryboard}" />
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--  Delayed hover effect for Button  -->
                        <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="HoverDelayed">
                            <Setter TargetName="ContentBorder" Property="BorderThickness" Value="2" />
                            <Setter TargetName="ContentBorder" Property="CornerRadius" Value="3" />
                            <Setter TargetName="ContentBorder" Property="BorderBrush" Value="{DynamicResource SecondaryAccentBrush}" />
                        </DataTrigger>

                        <!--  Animation Triggers for better user experience  -->
                        <EventTrigger RoutedEvent="Expander.Expanded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.8"
                                                     To="1.0"
                                                     Duration="0:0:0.2" />
                                    <DoubleAnimation Storyboard.TargetName="ContentBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="0.7"
                                                     To="1.0"
                                                     Duration="0:0:0.3" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>

                        <EventTrigger RoutedEvent="Expander.Collapsed">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="HeaderBorder"
                                                     Storyboard.TargetProperty="Opacity"
                                                     From="1.0"
                                                     To="0.9"
                                                     Duration="0:0:0.1" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsExpanded" Value="True">
                <!--  Setting Width properly to ensure proper layout  -->
                <Setter Property="Width" Value="NaN" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
