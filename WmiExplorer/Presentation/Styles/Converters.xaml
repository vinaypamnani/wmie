<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:WmiExplorer.Presentation.Converters">
    <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="InverseBooleanConverter" Invert="True" />
    <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />    <conv:NewLineToSpaceConverter x:Key="NewLineToSpaceConverter" />
</ResourceDictionary>
