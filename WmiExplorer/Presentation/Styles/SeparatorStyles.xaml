<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        SeparatorStyles.xaml: Defines separator styles for various UI contexts.
        Uses the same pattern as ScrollBarStyles.xaml for default application.
    -->

    <!--  Named Separator Style for menus  -->
    <Style x:Key="ModernSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{StaticResource MarginVerticalSmall}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1"
                               Margin="{StaticResource MarginHorizontalSmall}"
                               Fill="{TemplateBinding Background}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Basic Separator Style for minimal separations  -->
    <Style x:Key="BasicSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{StaticResource MarginVerticalTiny}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Subtle Separator Style for less prominent separations  -->
    <Style x:Key="SubtleSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TertiaryBackgroundBrush}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="{StaticResource MarginVerticalTiny}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Thick Separator Style for more prominent separations  -->
    <Style x:Key="ThickSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Height" Value="2" />
        <Setter Property="Margin" Value="{StaticResource MarginVerticalSmall}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="2" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Vertical Separator Style for horizontal layouts  -->
    <Style x:Key="VerticalSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="{StaticResource MarginHorizontalTiny}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Width="1" Fill="{TemplateBinding Background}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
