<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!--  Standard TextBox Context Menu  -->
    <ContextMenu x:Key="TextBoxContextMenu">
        <MenuItem Command="ApplicationCommands.Cut" Header="Cut">
            <MenuItem.Icon>
                <ContentControl ContentTemplate="{StaticResource CutIconTemplate}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="ApplicationCommands.Copy" Header="Copy">
            <MenuItem.Icon>
                <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="ApplicationCommands.Paste" Header="Paste">
            <MenuItem.Icon>
                <ContentControl ContentTemplate="{StaticResource PasteIconTemplate}" />
            </MenuItem.Icon>
        </MenuItem>
        <MenuItem Command="ApplicationCommands.SelectAll" Header="Select All">
            <MenuItem.Icon>
                <ContentControl ContentTemplate="{StaticResource SelectAllIconTemplate}" />
            </MenuItem.Icon>
        </MenuItem>
    </ContextMenu>

    <!--  TextBox  -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="Margin" Value="{StaticResource MarginSmall}" />
        <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="false" />
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="{DynamicResource PaddingLeftTiny}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}">
                                <TextBlock.Visibility>
                                    <Binding Converter="{StaticResource StringEmptyToVisibilityConverter}" Path="Text" RelativeSource="{RelativeSource TemplatedParent}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource FocusedElementBrush}" />
                            <Setter TargetName="TextBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  SimpleTextBox Style: Minimal, no border, background, or placeholder logic  -->
    <Style x:Key="TransparentTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
    </Style>

    <!--  PasswordBox  -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="Margin" Value="{StaticResource MarginSmall}" />
        <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource FocusedElementBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  TextBoxWithPlaceholder Style  - named to avoid updating all code that uses TextBoxWithPlaceholder  -->
    <Style x:Key="TextBoxWithPlaceholder" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox" />

    <!--  TextBoxWithClearButton Style  -->
    <Style x:Key="TextBoxWithClearButton" BasedOn="{StaticResource TextBoxWithPlaceholder}" TargetType="TextBox">
        <Setter Property="behaviors:TextBoxClearButtonBehavior.EnableClearButton" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid VerticalAlignment="Center">
                            <!--  Search Icon  -->
                            <Viewbox Width="16"
                                     Height="16"
                                     Margin="4,0,0,0"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center">
                                <Canvas Width="16" Height="16">
                                    <!--  Adjusted magnifying glass icon for better vertical centering  -->
                                    <Ellipse Canvas.Left="1"
                                             Canvas.Top="2"
                                             Width="10"
                                             Height="10"
                                             Stroke="Gray"
                                             StrokeThickness="2" />
                                    <Line Stroke="Gray"
                                          StrokeThickness="2"
                                          X1="9"
                                          X2="14"
                                          Y1="10"
                                          Y2="15" />
                                </Canvas>
                            </Viewbox>
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="20,0,0,0"
                                          Background="Transparent"
                                          Focusable="false" />
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="26,0,0,0"
                                       Padding="{StaticResource PaddingLeftTiny}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}">
                                <TextBlock.Visibility>
                                    <Binding Converter="{StaticResource StringEmptyToVisibilityConverter}" Path="Text" RelativeSource="{RelativeSource TemplatedParent}" />
                                </TextBlock.Visibility>
                            </TextBlock>
                            <!--  Clear Button  -->
                            <Button x:Name="PART_ClearButton"
                                    Width="18"
                                    Height="18"
                                    Margin="4,0,4,0"
                                    Padding="0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Focusable="False"
                                    ToolTip="Clear">
                                <Button.Visibility>
                                    <Binding Converter="{StaticResource StringNotEmptyToVisibilityConverter}" Path="Text" RelativeSource="{RelativeSource TemplatedParent}" />
                                </Button.Visibility>
                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                      Stroke="Gray"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round"
                                      StrokeThickness="2" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{DynamicResource FocusedElementBrush}" />
                            <Setter TargetName="TextBorder" Property="BorderThickness" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBlock  -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    </Style>

    <!--  Expander Text Block style  -->
    <Style x:Key="ExpanderTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <RotateTransform Angle="90" />
            </Setter.Value>
        </Setter>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=Expander}}" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TertiaryForegroundBrush}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Hyperlink  -->
    <Style TargetType="Hyperlink">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryAccentBrush}" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>

</ResourceDictionary>
