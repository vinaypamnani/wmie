<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors">

    <!-- Standard TextBox Context Menu -->
    <ContextMenu x:Key="TextBoxContextMenu">
        <MenuItem Command="ApplicationCommands.Cut" Header="Cut" />
        <MenuItem Command="ApplicationCommands.Copy" Header="Copy" />
        <MenuItem Command="ApplicationCommands.Paste" Header="Paste" />
        <MenuItem Command="ApplicationCommands.SelectAll" Header="Select All" />
    </ContextMenu>

    <!--  TextBox  -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
        <Setter Property="Margin" Value="{StaticResource MarginSmall}" />
        <Setter Property="ContextMenu" Value="{StaticResource TextBoxContextMenu}" />

        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource DisabledForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource DisabledBackgroundBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource DisabledBorderBrush}" />
                <Setter Property="BorderThickness" Value="0" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  TextBoxWithPlaceholder Style  -->
    <Style x:Key="TextBoxWithPlaceholder" BasedOn="{StaticResource {x:Type TextBox}}" TargetType="TextBox">
        <Setter Property="CaretBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="false" />
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="{TemplateBinding Padding}"
                                       Padding="{StaticResource PaddingLeftTiny}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DataTrigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBoxWithClearButton Style  -->
    <Style x:Key="TextBoxWithClearButton" BasedOn="{StaticResource TextBoxWithPlaceholder}" TargetType="TextBox">
        <Setter Property="behaviors:TextBoxClearButtonBehavior.EnableClearButton" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="TextBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource PrimaryAccentBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid VerticalAlignment="Center">
                            <!-- Search Icon -->
                            <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="4,0,0,0">
                                <Canvas Width="16" Height="16">
                                    <!-- Adjusted magnifying glass icon for better vertical centering -->
                                    <Ellipse Stroke="Gray" StrokeThickness="2" Width="10" Height="10" Canvas.Left="1" Canvas.Top="2" />
                                    <Line X1="9" Y1="10" X2="14" Y2="15" Stroke="Gray" StrokeThickness="2" />
                                </Canvas>
                            </Viewbox>
                            <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="false" Margin="24,0,0,0" />
                            <TextBlock x:Name="PlaceholderText"
                                       Margin="24,0,0,0"
                                       Padding="{StaticResource PaddingLeftTiny}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       IsHitTestVisible="False"
                                       Text="{TemplateBinding Tag}"
                                       Visibility="Collapsed" />
                            <!-- Clear Button -->
                            <Button x:Name="PART_ClearButton"
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Margin="4,0,4,0"
                                    Padding="0"
                                    Focusable="False"
                                    Visibility="Visible"
                                    Cursor="Hand"
                                    ToolTip="Clear"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    BorderBrush="Transparent">
                                <Path Data="M3,3 L9,9 M9,3 L3,9"
                                      Stroke="Gray"
                                      StrokeThickness="2"
                                      StrokeEndLineCap="Round"
                                      StrokeStartLineCap="Round" />
                            </Button>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Show placeholder and hide clear button if empty or null -->
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                            <Setter TargetName="TextBorder" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Show clear button only when Text is not empty or null -->
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="{x:Null}">
                            <Setter TargetName="PART_ClearButton" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <!-- Default: PART_ClearButton is Visible when Text is not empty or null -->
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  TextBlock  -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
    </Style>

</ResourceDictionary>
