<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:conv="clr-namespace:WmiExplorer.Presentation.Converters">
    <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    <conv:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter" />
    <conv:EnumFlagsToBooleanConverter x:Key="EnumFlagsToBooleanConverter" />
    <conv:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <conv:BoolToVisibilityConverter x:Key="InverseBooleanConverter" Invert="True" />
    <conv:BooleanToDoubleConverter x:Key="BooleanToDoubleConverter" FalseValue="0" TrueValue="NaN" />
    <conv:NullToBoolConverter x:Key="NullToBoolConverter" />
    <conv:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
    <conv:NewLineToSpaceConverter x:Key="NewLineToSpaceConverter" />
    <conv:StringNotEmptyToVisibilityConverter x:Key="StringNotEmptyToVisibilityConverter" />
</ResourceDictionary>
