<UserControl
    x:Class="WmiExplorer.Presentation.UserControls.WmiNamespacesPane"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <Grid>
        <Expander
            Name="ExpanderNamespaces"
            Padding="0,3,0,0"
            BorderThickness="0"
            ExpandDirection="Right"
            Style="{StaticResource VerticalHeaderExpanderStyle}"
            IsExpanded="{Binding WindowPosition.IsNamespacesExpanded, Mode=TwoWay}">
            <Expander.Header>
                <Border Width="25">
                    <TextBlock
                        FontSize="15"
                        FontWeight="SemiBold"
                        Text="Namespaces">
                        <TextBlock.LayoutTransform>
                            <RotateTransform Angle="90" />
                        </TextBlock.LayoutTransform>
                    </TextBlock>
                </Border>
            </Expander.Header>
            <TreeView
                Name="WmiNamespaces"
                Margin="3,3,0,0"
                behaviors:TreeViewAutoScrollBehavior.AutoScroll="True"
                behaviors:TreeViewSelectedItemBehavior.SelectedItem="{Binding SelectedNamespace}"
                ItemsSource="{Binding Namespaces}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource BaseTreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="behaviors:TreeViewItemDoubleClickBehavior.Command" Value="{Binding LoadClassesCommand}" />
                        <Setter Property="behaviors:TreeViewSelectedItemBehavior.EnableForceSelection" Value="True" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Header="Copy Relative Path" Command="{Binding CopyRelativePathCommand}" />
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <Grid
                                Width="16"
                                Height="16"
                                Margin="3,1">
                                <Ellipse
                                    Width="10"
                                    Height="10"
                                    RenderTransformOrigin="0.5,0.5"
                                    Style="{DynamicResource StatusIndicatorStyle}" />
                            </Grid>
                            <TextBlock Margin="3,1" Text="{Binding Name}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Expander>
    </Grid>
</UserControl>