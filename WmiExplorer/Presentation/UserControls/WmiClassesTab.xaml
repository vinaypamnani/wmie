<UserControl
    x:Class="WmiExplorer.Presentation.UserControls.WmiClassesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:userControls="clr-namespace:WmiExplorer.Presentation.UserControls"
    xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid x:Name="ClassesGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding WindowPosition.ClassesColumnGridLength, Mode=TwoWay}" />
            <ColumnDefinition Width="Auto" />
            <!--  Changed from fixed 15px to Auto  -->
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!--  Classes View Content  -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Expander
                Name="ExpanderClasses"
                Padding="0,3,0,0"
                BorderThickness="0"
                ExpandDirection="Right"
                IsExpanded="{Binding WindowPosition.IsClassesExpanded, Mode=TwoWay}"
                Style="{StaticResource VerticalHeaderExpanderStyle}">
                <Expander.Header>
                    <Border Width="25">
                        <TextBlock FontSize="15" FontWeight="SemiBold" Text="Classes">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                </Expander.Header>
                <Expander.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBox
                            Grid.Row="0"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBoxWithPlaceholder}"
                            Tag="Quick Filter Classes..."
                            Text="{Binding SelectedNamespace.QuickFilterClasses, UpdateSourceTrigger=PropertyChanged}" />                        <ListView
                            Grid.Row="1"
                            Style="{StaticResource ModernGridListViewStyle}"
                            behaviors:ListViewAutoScrollBehavior.AutoScroll="True"
                            behaviors:ListViewAutoScrollBehavior.DisableVirtualization="True"
                            behaviors:ListViewAutoScrollBehavior.SelectedItemMonitor="{Binding SelectedNamespace.SelectedClass}"
                            behaviors:ListViewSortBehavior.EnableSorting="True"
                            BorderThickness="1"
                            ItemsSource="{Binding SelectedNamespace.ClassesView}"
                            SelectedItem="{Binding SelectedNamespace.SelectedClass}"
                            SelectionMode="Single">
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource FlatGridViewColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="40">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Grid Width="16" Height="16" Margin="3,1">
                                                    <Ellipse
                                                        Width="10"
                                                        Height="10"
                                                        RenderTransformOrigin="0.5,0.5"
                                                        Style="{DynamicResource StatusIndicatorStyle}" />
                                                </Grid>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="150" behaviors:ListViewSortBehavior.SortProperty="ClassName" Header="Class Name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Margin="5,0" Text="{Binding ClassName}" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="150" behaviors:ListViewSortBehavior.SortProperty="Description" Header="Description">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    MaxHeight="20"
                                                    Margin="5,0"
                                                    Text="{Binding Description}"
                                                    TextTrimming="CharacterEllipsis"
                                                    TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource FlatListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                                    <Setter Property="behaviors:ListViewItemDoubleClickBehavior.Command" Value="{Binding LoadInstancesCommand}" />
                                    <Setter Property="behaviors:ListViewItemSelectionBehavior.EnableForceSelection" Value="True" />
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Expander.Content>
            </Expander>
        </Grid>

        <GridSplitter
            Grid.Row="0"
            Grid.Column="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Stretch"
            Visibility="{Binding WindowPosition.IsClassesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TabControl Grid.Row="0" Grid.Column="2">
            <TabItem Header="Instances">
                <!--  Instances View  -->
                <userControls:WmiInstancesTab />
            </TabItem>
            <TabItem Header="Properties">
                <!--  Properties View  -->
                <userControls:WmiPropertiesTab />
            </TabItem>
            <TabItem Header="Methods">
                <!--  Methods View  -->
                <userControls:WmiMethodsTab />
            </TabItem>
        </TabControl>

        <!--  Query GroupBox spanning all columns  -->
        <GroupBox
            Grid.Row="1"
            Grid.ColumnSpan="3"
            Margin="0,5,0,0"
            Header="Query">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    Grid.Column="0"
                    Margin="5"
                    IsEnabled="False"
                    Style="{StaticResource TextBoxWithPlaceholder}"
                    Tag="Automatically created query here" />
                <Button
                    Grid.Column="1"
                    MinWidth="75"
                    Margin="5"
                    Content="Execute" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
