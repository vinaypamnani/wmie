<UserControl x:Class="WmiExplorer.Presentation.Controls.UserControls.ProgressBarIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WmiExplorer.Common.Enums"
             Width="96"
             Height="22">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource Self}}" Value="{x:Static enums:AppState.Busy}">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>
    <UserControl.Resources>
        <Storyboard x:Key="ProgressBarAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ProgressBarTransform"
                             Storyboard.TargetProperty="X"
                             From="-58"
                             To="58"
                             Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>
    <Border x:Name="ProgressBarContainer"
            Width="96"
            Height="5"
            Margin="4,0,8,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderBrush}"
            ClipToBounds="True"
            CornerRadius="2.5">
        <Border.Triggers>
            <EventTrigger RoutedEvent="Border.Loaded">
                <BeginStoryboard Storyboard="{StaticResource ProgressBarAnimation}" />
            </EventTrigger>
        </Border.Triggers>
        <Rectangle x:Name="ProgressBar"
                   Width="20"
                   Height="5"
                   Fill="{DynamicResource BaseBlueBrush}"
                   RadiusX="2.5"
                   RadiusY="2.5"
                   RenderTransformOrigin="0.5,0.5">
            <Rectangle.RenderTransform>
                <TranslateTransform x:Name="ProgressBarTransform" />
            </Rectangle.RenderTransform>
        </Rectangle>
    </Border>
</UserControl>
