<UserControl x:Class="WmiExplorer.Presentation.Controls.UserControls.CollapsibleTextBlock"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Toggle Button  -->
        <TextBlock Name="ToggleButton"
                   Grid.Column="0"
                   Margin="0,0,8,0"
                   VerticalAlignment="Top"
                   Cursor="Hand"
                   FontSize="12"
                   Foreground="{DynamicResource PrimaryAccentBrush}"
                   MouseLeftButtonDown="ToggleButton_MouseLeftButtonDown">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="More" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                            <Setter Property="Text" Value="Less" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!--  Content TextBlock  -->
        <TextBlock Name="ContentTextBlock"
                   Grid.Column="1"
                   FontSize="12"
                   FontWeight="Normal"
                   Foreground="{Binding TextForeground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   ToolTip="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsExpanded, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                            <Setter Property="MaxHeight" Value="19" />
                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                            <Setter Property="TextWrapping" Value="NoWrap" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</UserControl>
