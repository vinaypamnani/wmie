<UserControl x:Class="WmiExplorer.Presentation.Controls.UserControls.EnhancedStatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WmiExplorer.Common.Enums"
             Height="22"
             MinWidth="180">

    <!--
        EnhancedStatusIndicator now supports external AppState and Message bindings via dependency properties.
        All bindings reference these properties using RelativeSource.
    -->

    <UserControl.Resources>
        <!--  Animations  -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation AutoReverse="True"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0"
                             To="0.3"
                             Duration="0:0:1.5" />
        </Storyboard>

        <!--  Progress Bar Animation  -->
        <Storyboard x:Key="ProgressBarAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ProgressBarTransform"
                             Storyboard.TargetProperty="X"
                             From="-58"
                             To="58"
                             Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>

    <Border Padding="2,0,10,0"
            Background="Transparent"
            BorderBrush="Transparent"
            BorderThickness="1"
            CornerRadius="10">

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="IndicatorColumn" Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Status Indicator Section (Left)  -->
            <Grid x:Name="StatusIndicators"
                  Grid.Column="0"
                  Width="22"
                  Margin="2,0,4,0">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Busy}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!--  Indeterminate Indicator (Gray)  -->
                <Ellipse x:Name="IndeterminateEllipse"
                         Width="14"
                         Height="14"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource BaseGrayBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Indeterminate}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!--  Error Indicator (Red)  -->
                <Ellipse Width="14"
                         Height="14"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource BaseRedBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Error}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!--  Ready/Success Indicator (Green)  -->
                <Ellipse Width="14"
                         Height="14"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource BaseGreenBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Ready}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Success}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>

                <!--  Warning Indicator (Yellow/Orange)  -->
                <Ellipse Width="14"
                         Height="14"
                         HorizontalAlignment="Center"
                         Fill="{DynamicResource BaseOrangeBrush}">
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Warning}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Ellipse.Loaded">
                            <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
            </Grid>

            <!--  Progress Bar for Busy state  -->
            <Border x:Name="ProgressBarContainer"
                    Grid.Column="0"
                    Width="96"
                    Height="5"
                    Margin="4,0,8,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderBrush}"
                    ClipToBounds="True"
                    CornerRadius="2.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource ProgressBarAnimation}" />
                    </EventTrigger>
                </Border.Triggers>
                <Rectangle x:Name="ProgressBar"
                           Width="20"
                           Height="5"
                           Fill="{DynamicResource SecondaryAccentBrush}"
                           RadiusX="2.5"
                           RadiusY="2.5"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ProgressBarTransform" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>

            <!--  Message Text Section (Right)  -->
            <TextBlock Grid.Column="1"
                       Margin="2,0,4,0"
                       VerticalAlignment="Center"
                       Text="{Binding Message, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       TextTrimming="CharacterEllipsis" />

            <!--  Border Glow Effect for Busy State  -->
            <Border x:Name="BorderGlowEffect"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Margin="0"
                    BorderBrush="{DynamicResource SecondaryAccentBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Opacity="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation AutoReverse="True"
                                                 Storyboard.TargetProperty="Opacity"
                                                 From="0"
                                                 To="0.4"
                                                 Duration="0:0:1.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </Grid>
    </Border>
</UserControl>
