<UserControl x:Class="WmiExplorer.Presentation.Controls.UserControls.IconIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WmiExplorer.Common.Enums"
             Width="20"
             Height="20">
    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation AutoReverse="True"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0"
                             To="0.3"
                             Duration="0:0:1.5" />
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <Ellipse x:Name="StatusEllipse"
                 Width="14"
                 Height="14"
                 HorizontalAlignment="Center"
                 Fill="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource AppStateToBrushConverter}}">
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Ellipse.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Grid>
</UserControl>
