<UserControl x:Class="WmiExplorer.Presentation.Controls.UserControls.IconIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:enums="clr-namespace:WmiExplorer.Common.Enums"
             Width="20"
             Height="20">
    <UserControl.Resources>
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation AutoReverse="True"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0"
                             To="0.3"
                             Duration="0:0:1.5" />
        </Storyboard>
    </UserControl.Resources>
    <Grid>
        <!--  Indeterminate Indicator (Gray)  -->
        <Ellipse x:Name="IndeterminateEllipse"
                 Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 Fill="{DynamicResource BaseGrayBrush}">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Indeterminate}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Ellipse.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <!--  Error Indicator (Red)  -->
        <Ellipse x:Name="ErrorEllipse"
                 Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 Fill="{DynamicResource BaseRedBrush}">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Error}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Ellipse.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <!--  Ready/Success Indicator (Green)  -->
        <Ellipse Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 Fill="{DynamicResource BaseGreenBrush}">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Ready}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Success}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Ellipse.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
        <!--  Warning Indicator (Yellow/Orange)  -->
        <Ellipse Width="16"
                 Height="16"
                 HorizontalAlignment="Center"
                 Fill="{DynamicResource BaseOrangeBrush}">
            <Ellipse.Style>
                <Style TargetType="Ellipse">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AppState, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static enums:AppState.Warning}">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Ellipse.Style>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Ellipse.Loaded">
                    <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>
    </Grid>
</UserControl>
