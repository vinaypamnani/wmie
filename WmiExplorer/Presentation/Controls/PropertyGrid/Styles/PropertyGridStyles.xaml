<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:WmiExplorer.Presentation.Controls.PropertyGrid"
                    xmlns:converters="clr-namespace:WmiExplorer.Presentation.Controls.PropertyGrid.Converters">

    <!-- ================================================================ -->
    <!-- COMMON STYLES AND RESOURCES                                       -->
    <!-- ================================================================ -->

    <!-- Common style for property text -->
    <Style x:Key="PropertyTextBlockStyle"
            TargetType="TextBlock">
        <Setter Property="Margin"
                Value="0,2" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
        <Setter Property="Foreground"
                Value="{DynamicResource PropertyGridForegroundBrush}" />
        <Setter Property="TextTrimming"
                Value="CharacterEllipsis" />
    </Style>

    <!-- Common template for property description tooltips -->
    <DataTemplate x:Key="PropertyDescriptionTooltip">
        <TextBlock Text="{Binding Description}"
                   TextWrapping="Wrap"
                   MaxWidth="300" />
    </DataTemplate>

    <!-- ================================================================ -->
    <!-- STYLES                                                           -->
    <!-- ================================================================ -->

    <!-- Overlay style for scrollbars used in property grid -->
    <Style x:Key="OverlayScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Opacity" Value="0.6" />
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid>
                        <Track Name="PART_Track"
                               IsDirectionReversed="true"
                               Value="{TemplateBinding Value}"
                               Minimum="{TemplateBinding Minimum}"
                               Maximum="{TemplateBinding Maximum}"
                               ViewportSize="{TemplateBinding ViewportSize}">
                            <Track.Thumb>
                                <Thumb>
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="#AA888888" CornerRadius="4" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>

    <!-- Style for the CustomPropertyEditor -->
    <Style TargetType="{x:Type local:CustomPropertyEditor}">
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CustomPropertyEditor}">
                    <Border Background="Transparent"
                            SnapsToDevicePixels="True"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for ScrollViewer in CustomPropertyGrid to handle mouse wheel scrolling properly -->
    <Style x:Key="PropertyGridScrollViewerStyle"
            TargetType="{x:Type ScrollViewer}"
            BasedOn="{StaticResource ModernScrollViewerStyle}">
        <Setter Property="PanningMode"
                Value="Both" />
        <Setter Property="IsTabStop"
                Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
</ResourceDictionary>