<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:WmiExplorer.Presentation.ColorPicker">

    <!--  Converters  -->
    <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:ColorToNameConverter x:Key="ColorToNameConverter" />

    <!--  Button Style for color preview  -->
    <Style x:Key="ColorPickerButtonStyle" TargetType="Button">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="2">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style for the color cells in the palette  -->
    <Style x:Key="ColorCellStyle" TargetType="Button">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ToolTip" Value="{Binding Converter={StaticResource ColorToNameConverter}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!--  Checkerboard background for transparency  -->
                        <Grid x:Name="Checkerboard" Visibility="Collapsed">
                            <Rectangle Fill="#FFF" />
                            <Rectangle Width="10"
                                       Height="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Fill="#CCC" />
                            <Rectangle Width="10"
                                       Height="10"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Fill="#CCC" />
                        </Grid>
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Show checkerboard if Background is Transparent  -->
                        <DataTrigger Binding="{Binding Background.(SolidColorBrush.Color), RelativeSource={RelativeSource Self}}" Value="{x:Static Colors.Transparent}">
                            <Setter TargetName="Checkerboard" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Border" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Tab Control Style  -->
    <Style x:Key="ColorPickerTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource TertiaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="TabStripPlacement" Value="Top" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  Tab Item Style  -->
    <Style x:Key="ColorPickerTabItemStyle" TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="4,4,0,0">
                        <ContentPresenter x:Name="ContentSite"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          ContentSource="Header" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource PrimaryAccentBrush}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource PrimaryBackgroundBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Custom Slider Style  -->
    <Style x:Key="ColorPickerSliderStyle" TargetType="Slider">
        <Setter Property="Height" Value="20" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid>
                        <Border x:Name="TrackBackground"
                                Height="4"
                                Margin="0,8,0,8"
                                VerticalAlignment="Center"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="2" />
                        <Track x:Name="PART_Track" VerticalAlignment="Center" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton x:Name="PART_DecreaseRepeatButton" Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="DecreaseButton" Background="Transparent" BorderThickness="0" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb x:Name="Thumb" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse x:Name="ThumbCircle"
                                                     Width="16"
                                                     Height="16"
                                                     Fill="{DynamicResource PrimaryBackgroundBrush}"
                                                     Stroke="{DynamicResource PrimaryAccentBrush}"
                                                     StrokeThickness="2" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbCircle" Property="Stroke" Value="{DynamicResource PrimaryAccentBrush}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton x:Name="PART_IncreaseRepeatButton" Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="IncreaseButton" Background="Transparent" BorderThickness="0" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Default Style for ColorPicker Control  -->
    <Style TargetType="{x:Type local:ColorPicker}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:ColorPicker}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Color preview and dropdown button  -->
                        <Button x:Name="PART_ColorButton"
                                Grid.Row="0"
                                Height="24"
                                Background="{Binding SelectedColorBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Style="{StaticResource ColorPickerButtonStyle}" />

                        <!--  Popup with color picker  -->
                        <Popup x:Name="PART_ColorPickerPopup"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PlacementTarget="{Binding ElementName=PART_ColorButton}"
                               StaysOpen="False">
                            <Border Padding="8"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <Grid Width="320">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  Color Picker Content  -->
                                    <TabControl Grid.Row="0" Style="{StaticResource ColorPickerTabControlStyle}">
                                        <TabItem Header="Colors" Style="{StaticResource ColorPickerTabItemStyle}">
                                            <StackPanel>
                                                <!--  Available Colors  -->
                                                <TextBlock Margin="0,0,0,4"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           Text="Available Colors" />
                                                <ItemsControl ItemsSource="{Binding AvailableColors, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="11" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Background="{Binding}"
                                                                    Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=local:ColorPicker}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ColorCellStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!--  Standard Colors  -->
                                                <TextBlock Margin="0,8,0,4"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           Text="Standard Colors" />
                                                <ItemsControl ItemsSource="{Binding StandardColors, RelativeSource={RelativeSource TemplatedParent}}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <UniformGrid Columns="11" Rows="1" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Button Background="{Binding}"
                                                                    Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=local:ColorPicker}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ColorCellStyle}" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </TabItem>

                                        <TabItem Header="HSV" Style="{StaticResource ColorPickerTabItemStyle}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="200" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <!--  Saturation/Value Canvas  -->
                                                <local:SaturationValueCanvas x:Name="PART_SaturationValueCanvas"
                                                                             Grid.Row="0"
                                                                             Margin="0,0,0,8"
                                                                             Hue="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}}"
                                                                             Saturation="{Binding Saturation, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                                             Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                                                <!--  Hue Slider  -->
                                                <local:HueSlider x:Name="PART_HueSlider"
                                                                 Grid.Row="1"
                                                                 Height="20"
                                                                 Hue="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                            </Grid>
                                        </TabItem>

                                        <TabItem Header="RGB" Style="{StaticResource ColorPickerTabItemStyle}">
                                            <StackPanel Margin="0,8">
                                                <!--  Red Slider  -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               Text="R:" />
                                                    <Slider Grid.Column="1"
                                                            Maximum="255"
                                                            Minimum="0"
                                                            Style="{StaticResource ColorPickerSliderStyle}"
                                                            Value="{Binding Red, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="2"
                                                             Width="40"
                                                             Margin="8,0,0,0"
                                                             Text="{Binding Red, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>

                                                <!--  Green Slider  -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               Text="G:" />
                                                    <Slider Grid.Column="1"
                                                            Maximum="255"
                                                            Minimum="0"
                                                            Style="{StaticResource ColorPickerSliderStyle}"
                                                            Value="{Binding Green, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="2"
                                                             Width="40"
                                                             Margin="8,0,0,0"
                                                             Text="{Binding Green, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>

                                                <!--  Blue Slider  -->
                                                <Grid Margin="0,0,0,8">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               Text="B:" />
                                                    <Slider Grid.Column="1"
                                                            Maximum="255"
                                                            Minimum="0"
                                                            Style="{StaticResource ColorPickerSliderStyle}"
                                                            Value="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="2"
                                                             Width="40"
                                                             Margin="8,0,0,0"
                                                             Text="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>

                                                <!--  Alpha Slider (if enabled)  -->
                                                <Grid Margin="0,0,0,8" Visibility="{Binding ShowAlphaChannel, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Margin="0,0,8,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                               Text="A:" />
                                                    <Slider Grid.Column="1"
                                                            Maximum="255"
                                                            Minimum="0"
                                                            Style="{StaticResource ColorPickerSliderStyle}"
                                                            Value="{Binding Alpha, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                                    <TextBox Grid.Column="2"
                                                             Width="40"
                                                             Margin="8,0,0,0"
                                                             Text="{Binding Alpha, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </StackPanel>
                                        </TabItem>
                                    </TabControl>

                                    <!--  Recent Colors  -->
                                    <Grid Grid.Row="1" Margin="0,8,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0"
                                                   Margin="0,0,0,4"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                   Text="Recent Colors"
                                                   Visibility="{Binding ShowRecentColors, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}" />

                                        <ItemsControl Grid.Row="1" ItemsSource="{Binding RecentColors, RelativeSource={RelativeSource TemplatedParent}}" Visibility="{Binding ShowRecentColors, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="11" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Background="{Binding}"
                                                            Command="{Binding SelectColorCommand, RelativeSource={RelativeSource AncestorType=local:ColorPicker}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ColorCellStyle}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!--  Advanced Section  -->
                                    <TextBlock Grid.Row="2"
                                               Margin="0,8,0,4"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                                               Text="Advanced" />

                                    <!--  Info and Input Panel: Improved Advanced Layout with StackPanels  -->
                                    <Grid Grid.Row="3" Margin="0,0,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="3*" />
                                            <ColumnDefinition Width="2*" />
                                        </Grid.ColumnDefinitions>

                                        <!--  Row 0: R, H, Preview label  -->
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="R:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Red, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="H:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Hue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <!--  Row 0/1: Preview label and border in a StackPanel  -->
                                        <StackPanel Grid.Row="0"
                                                    Grid.RowSpan="2"
                                                    Grid.Column="2"
                                                    Margin="0,2,0,8"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">
                                            <TextBlock Margin="0,0,0,4"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="Preview" />
                                            <Border Width="40"
                                                    Height="40"
                                                    Background="{Binding SelectedColorBrush, RelativeSource={RelativeSource TemplatedParent}}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" />
                                        </StackPanel>

                                        <!--  Row 1: G, S  -->
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="G:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Green, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="1"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="S:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Saturation, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>

                                        <!--  Row 2: B, V, Hex  -->
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="0"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="B:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Blue, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal">
                                            <TextBlock Width="16"
                                                       Margin="0,2,4,2"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                       Text="V:" />
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     VerticalAlignment="Center"
                                                     Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                        <StackPanel Grid.Row="2"
                                                    Grid.Column="2"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Orientation="Vertical">
                                            <TextBox MinWidth="40"
                                                     Margin="4,2,0,2"
                                                     HorizontalAlignment="Right"
                                                     Text="{Binding HexColor, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  Buttons  -->
                                    <StackPanel Grid.Row="4"
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal">
                                        <Button x:Name="PART_OKButton"
                                                Width="75"
                                                Height="24"
                                                Margin="0,0,16,0"
                                                Content="OK" />
                                        <Button x:Name="PART_CancelButton"
                                                Width="75"
                                                Height="24"
                                                Content="Cancel" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
