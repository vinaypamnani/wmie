<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.WmiSearchTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:shared="clr-namespace:WmiExplorer.Common.Shared"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Search Criteria GroupBox  -->
        <GroupBox Grid.Row="0"
                  Margin="8"
                  HorizontalContentAlignment="Stretch"
                  Header="Search Criteria">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Help Text  -->
                <TextBlock Grid.Row="0" Margin="4,4,4,4" Text="Select what to search and enter a search term. Use Recursive for deep search." />

                <!--  Search Controls Row  -->
                <Grid Grid.Row="1" Margin="4,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!--  Classes  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Methods  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Properties  -->
                        <ColumnDefinition Width="*" />
                        <!--  Search TextBox  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Recursive  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Search Button  -->
                        <ColumnDefinition Width="Auto" />
                        <!--  Cancel Button  -->
                    </Grid.ColumnDefinitions>
                    <RadioButton Grid.Column="0"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Content="Classes"
                                 GroupName="SearchType"
                                 IsChecked="{Binding SearchType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shared:WmiSearchType.Class}}" />
                    <RadioButton Grid.Column="1"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Content="Methods"
                                 GroupName="SearchType"
                                 IsChecked="{Binding SearchType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shared:WmiSearchType.Method}}" />
                    <RadioButton Grid.Column="2"
                                 Margin="0,0,16,0"
                                 VerticalAlignment="Center"
                                 Content="Properties"
                                 GroupName="SearchType"
                                 IsChecked="{Binding SearchType, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter={x:Static shared:WmiSearchType.Property}}" />
                    <TextBox Grid.Column="3"
                             Height="26"
                             MinWidth="120"
                             Margin="0,0,8,0"
                             HorizontalAlignment="Stretch"
                             VerticalAlignment="Center"
                             Style="{StaticResource TextBoxWithClearButton}"
                             Tag="Search..."
                             Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding ExecuteSearchCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <CheckBox Grid.Column="4"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"
                              Content="Recursive"
                              IsChecked="{Binding Recursive}" />
                    <Button Grid.Column="5"
                            Width="64"
                            Height="26"
                            Command="{Binding ExecuteSearchCommand}"
                            Content="Search" />
                    <Button Grid.Column="6"
                            Width="64"
                            Height="26"
                            Margin="4,0,8,0"
                            Command="{Binding CancelSearchCommand}"
                            Content="Cancel" />
                </Grid>

                <!--  Note Text  -->
                <TextBlock Grid.Row="2"
                           Margin="4,0,4,4"
                           FontWeight="Bold"
                           Foreground="OrangeRed"
                           Text="NOTE: Search can take a long time depending on scope and recursion." />
            </Grid>
        </GroupBox>

        <!--  Results GroupBox  -->
        <GroupBox Grid.Row="1"
                  Margin="8"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Header="Search Results">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <!--  Filter TextBox and Clear Button  -->
                <Grid Grid.Row="0" Margin="4,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Height="26"
                             Margin="0,0,8,0"
                             Style="{StaticResource TextBoxWithClearButton}"
                             Tag="Filter results..."
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1"
                            Width="80"
                            Height="26"
                            Command="{Binding ClearResultsCommand}"
                            Content="Clear Results" />
                </Grid>
                <!--  Results ListView  -->
                <ListView Grid.Row="1"
                          Margin="0"
                          BorderThickness="0"
                          ItemContainerStyle="{StaticResource ModernGridListViewItemStyle}"
                          ItemsSource="{Binding ResultsView}"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                          Style="{StaticResource ModernGridListViewStyle}">
                    <ListView.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding JumpToClassCommand}" Header="Jump to class" />
                        </ContextMenu>
                    </ListView.ContextMenu>
                    <ListView.View>
                        <GridView>
                            <!--  Name Column  -->
                            <GridViewColumn Width="Auto" Header="Name">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <TextBlock.Text>
                                                <PriorityBinding>
                                                    <Binding Path="Class.ClassName" />
                                                    <Binding Path="Method.Name" />
                                                    <Binding Path="Property.Name" />
                                                </PriorityBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!--  Type Column - Only visible for Property searches  -->
                            <GridViewColumn Header="Type">
                                <GridViewColumn.Width>
                                    <Binding Converter="{StaticResource BooleanToDoubleConverter}"
                                             ConverterParameter="{x:Static shared:WmiSearchType.Property}"
                                             Path="DataContext.SearchType"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </GridViewColumn.Width>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Property.Type}" Visibility="{Binding DataContext.SearchType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static shared:WmiSearchType.Property}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>

                            <!--  IsStatic Column - Only visible for Method searches  -->
                            <GridViewColumn Header="IsStatic">
                                <GridViewColumn.Width>
                                    <Binding Converter="{StaticResource BooleanToDoubleConverter}"
                                             ConverterParameter="{x:Static shared:WmiSearchType.Method}"
                                             Path="DataContext.SearchType"
                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                </GridViewColumn.Width>
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Method.IsStatic}" Visibility="{Binding DataContext.SearchType, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter={x:Static shared:WmiSearchType.Method}}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!--  Path Column  -->
                            <GridViewColumn Width="Auto" Header="Path">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <TextBlock.Text>
                                                <PriorityBinding>
                                                    <Binding Path="Class.ClassPath" />
                                                    <Binding Path="Method.ClassPath" />
                                                    <Binding Path="Property.ClassPath" />
                                                </PriorityBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <!--  Description Column  -->
                            <GridViewColumn Width="Auto" Header="Description">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <TextBlock.Text>
                                                <PriorityBinding>
                                                    <Binding Converter="{StaticResource NewLineToSpaceConverter}" Path="Class.Description" />
                                                    <Binding Converter="{StaticResource NewLineToSpaceConverter}" Path="Method.Description" />
                                                    <Binding Converter="{StaticResource NewLineToSpaceConverter}" Path="Property.Description" />
                                                </PriorityBinding>
                                            </TextBlock.Text>
                                            <TextBlock.ToolTip>
                                                <PriorityBinding>
                                                    <Binding Path="Class.Description" />
                                                    <Binding Path="Method.Description" />
                                                    <Binding Path="Property.Description" />
                                                </PriorityBinding>
                                            </TextBlock.ToolTip>
                                        </TextBlock>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
