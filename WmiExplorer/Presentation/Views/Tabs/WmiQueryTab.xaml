<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.WmiQueryTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonbehaviors="clr-namespace:WmiExplorer.Presentation.Behaviors.AvalonEdit"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid x:Name="QueryGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Query GroupBox  -->
        <GroupBox Grid.Row="0" HorizontalContentAlignment="Stretch" Header="Query">
            <DockPanel LastChildFill="True">
                <Grid Margin="0,8,0,0" DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  Query Options  -->
                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <CheckBox Margin="0,0,12,0"
                                  Content="DirectRead"
                                  IsChecked="{Binding DirectRead}"
                                  ToolTip="Gets or sets a value indicating whether direct access to the WMI provider is requested for the specified class, without any regard to its super class or derived classes." />
                        <CheckBox Margin="0,0,12,0"
                                  Content="UseAmendedQualifiers"
                                  IsChecked="{Binding UseAmendedQualifiers}"
                                  ToolTip="Gets or sets a value indicating whether the objects returned from WMI should contain amended information. Typically, amended information is localizable information attached to the WMI object, such as object and property descriptions." />
                    </WrapPanel>

                    <!--  Action Buttons  -->
                    <Button Grid.Column="1"
                            Width="90"
                            Height="30"
                            Margin="8,0,8,0"
                            Command="{Binding ExecuteQueryCommand}"
                            Content="Execute"
                            IsDefault="True"
                            IsEnabled="{Binding IsQuerying, Converter={StaticResource InverseBooleanConverter}}">
                        <Button.Style>
                            <Style BasedOn="{StaticResource {x:Type Button}}" TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                <Setter Property="Foreground" Value="White" />
                            </Style>
                        </Button.Style>
                    </Button>

                    <Button Grid.Column="2"
                            Width="90"
                            Height="30"
                            Margin="0,0,0,0"
                            Command="{Binding CancelQueryCommand}"
                            Content="Cancel"
                            IsEnabled="{Binding IsQuerying}" />
                </Grid>

                <!--  Query Editor  -->
                <Border BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="2"
                        DockPanel.Dock="Top">
                    <avalonedit:TextEditor MinHeight="80"
                                           Margin="0"
                                           Padding="4"
                                           avalonbehaviors:AvalonEditCompletionBehavior.CacheService="{Binding CacheService}"
                                           avalonbehaviors:AvalonEditCompletionBehavior.EnableCompletion="True"
                                           avalonbehaviors:AvalonEditCompletionBehavior.Namespace="{Binding SelectedNamespace.NamespacePath}"
                                           avalonbehaviors:AvalonEditTextBindingBehavior.BoundText="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           avalonbehaviors:AvalonEditThemingBehavior.EnableTheming="True"
                                           avalonbehaviors:AvalonEditWqlHighlightingBehavior.EnableWqlHighlighting="True"
                                           Background="{DynamicResource PrimaryBackgroundBrush}"
                                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontFamily="Consolas, Courier New, Monospace"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           HorizontalScrollBarVisibility="Auto"
                                           LineNumbersForeground="{DynamicResource SecondaryForegroundBrush}"
                                           ShowLineNumbers="True"
                                           VerticalScrollBarVisibility="Auto" />
                </Border>
            </DockPanel>
        </GroupBox>

        <!--  Results GroupBox  -->
        <GroupBox Grid.Row="1"
                  Margin="8"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Header="Query Results">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Filter TextBox  -->
                <Grid Grid.Row="0" Margin="4,4,4,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Height="26"
                             Margin="0,0,8,0"
                             Style="{StaticResource TextBoxWithClearButton}"
                             Tag="Filter results..."
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <Button Grid.Column="1"
                            Width="80"
                            Height="26"
                            Command="{Binding ClearResultsCommand}"
                            Content="Clear Results" />
                </Grid>
                <!--  Results DataGrid  -->
                <DataGrid x:Name="ResultsDataGrid"
                          Grid.Row="1"
                          Margin="0"
                          AutoGenerateColumns="False"
                          Background="Transparent"
                          BorderThickness="0"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserReorderColumns="True"
                          CanUserResizeColumns="True"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          EnableColumnVirtualization="True"
                          EnableRowVirtualization="True"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          IsReadOnly="True"
                          ItemsSource="{Binding ResultsView}"
                          RowHeaderWidth="0"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                          SelectionMode="Extended"
                          SelectionUnit="FullRow"
                          VerticalScrollBarVisibility="Auto">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource ModernScrollBarStyle}" TargetType="ScrollBar" />
                    </DataGrid.Resources>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="{x:Type DataGridCell}">
                                        <Border Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                SnapsToDevicePixels="True">
                                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Style.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}" />
                            <Setter Property="Height" Value="24" />
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridColumnHeader">
                                        <Border x:Name="HeaderBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Margin="0,0,2,0" VerticalAlignment="Center" />
                                                <Path x:Name="SortArrow"
                                                      Grid.Column="1"
                                                      Width="10"
                                                      Height="10"
                                                      Margin="0,0,8,0"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Data="M 0,0 L 5,5 L 10,0"
                                                      Fill="{TemplateBinding Foreground}"
                                                      Opacity="0.7"
                                                      RenderTransformOrigin="0.5,0.5"
                                                      Stretch="Uniform"
                                                      StrokeThickness="0"
                                                      Visibility="Collapsed" />
                                                <Thumb x:Name="PART_HeaderGripper"
                                                       Grid.Column="1"
                                                       Width="{StaticResource SpacingLarge}"
                                                       Margin="0,0,-3,0"
                                                       HorizontalAlignment="Right"
                                                       Cursor="SizeWE"
                                                       Opacity="0" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource HoverBackgroundBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource PrimaryAccentBrush}" />
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Ascending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="SortArrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <Trigger Property="SortDirection" Value="Descending">
                                                <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                                                <Setter TargetName="SortArrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
