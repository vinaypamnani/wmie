<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.PropertiesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Properties Filter  -->
        <DockPanel Grid.Row="0" Margin="{StaticResource MarginSmall}">
            <TextBox VerticalAlignment="Center"
                     Style="{StaticResource TextBoxWithClearButton}"
                     Tag="Filter Properties..."
                     Text="{Binding PropertyFilterText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <!--  Properties List with Status Area  -->
        <GroupBox Grid.Row="1"
                  Margin="{StaticResource MarginSmall}"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Header="Properties">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Properties DataGrid  -->
                <DataGrid x:Name="PropertiesDataGrid"
                          Grid.Row="0"
                          ItemsSource="{Binding FilteredPropertiesView}"
                          SelectedItem="{Binding SelectedProperty}"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Columns>
                        <!--  Key Property Indicator Column  -->
                        <DataGridTemplateColumn Width="Auto" CanUserResize="False" Header="">
                            <DataGridTemplateColumn.CellTemplate>
                                <!-- <DataTemplate>
                                    <Path Width="12"
                                          Height="12"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Data="M6,0 L7.5,4.5 L12,4.5 L8.5,7.5 L10,12 L6,9 L2,12 L3.5,7.5 L0,4.5 L4.5,4.5 Z"
                                          Fill="{DynamicResource BaseOrangeBrush}"
                                          Stretch="Uniform"
                                          ToolTip="Key Property">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKey}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </DataTemplate>-->
                                <!-- <DataTemplate>
                                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center" Template="{StaticResource LetterIconTemplate}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="Foreground" Value="Black" />
                                                <Setter Property="Background" Value="{DynamicResource BaseOrangeBrush}" />
                                                <Setter Property="Content" Value="K" />
                                                <Setter Property="ToolTip" Value="Key Property" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKey}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>-->
                                <DataTemplate>
                                    <ContentControl ContentTemplate="{StaticResource KeyIconTemplate}" Foreground="{DynamicResource BaseGreenBrush}">
                                        <ContentControl.Style>
                                            <Style TargetType="ContentControl">
                                                <Setter Property="ToolTip" Value="Key Property" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsKey}" Value="False">
                                                        <Setter Property="Visibility" Value="Hidden" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentControl.Style>
                                    </ContentControl>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="Auto" Binding="{Binding Name}" Header="Property Name" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding Type}" Header="Type" />
                        <DataGridTextColumn Width="Auto" Binding="{Binding IsLazy, Mode=OneWay}" Header="Lazy" />
                        <DataGridTextColumn Width="*" Binding="{Binding Description, Converter={StaticResource NewLineToSpaceConverter}}" Header="Description" />
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Status Messages Area  -->
                <Border Grid.Row="1"
                        Margin="{StaticResource MarginSmall}"
                        Background="{DynamicResource PrimaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="3">
                    <StackPanel Margin="{StaticResource MarginSmall}" Orientation="Vertical">
                        <!--  Dynamic Help Text  -->
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="14"
                                   Opacity="0.7"
                                   Text="{Binding HelpText}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
