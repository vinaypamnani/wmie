<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.WmiEventWatcherTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WmiExplorer.Presentation.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:main="clr-namespace:WmiExplorer.Presentation.Views.Main"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="NotBoolToVisibilityConverter" Invert="True" />
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Configuration Panel: Compact Layout  -->

        <Grid Grid.Row="0">

            <GroupBox HorizontalContentAlignment="Stretch" BorderThickness="1" Header="Configuration">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Main controls  -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal">

                        <!--  Namespace  -->
                        <GroupBox Margin="0" Header="Namespace">
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <RadioButton Margin="0,0,6,0"
                                             VerticalAlignment="Center"
                                             Content="Selected"
                                             GroupName="NamespaceScope"
                                             IsChecked="True" />
                                <RadioButton VerticalAlignment="Center" Content="All" GroupName="NamespaceScope" />
                            </StackPanel>
                        </GroupBox>

                        <!--  Event Type  -->
                        <GroupBox Margin="0" Header="Event Type">
                            <ComboBox Width="200"
                                      Height="26"
                                      IsEditable="False"
                                      IsTextSearchEnabled="True">
                                <ComboBoxItem Content="__InstanceCreationEvent" />
                                <ComboBoxItem Content="__InstanceModificationEvent" />
                                <ComboBoxItem Content="__InstanceDeletionEvent" />
                                <ComboBoxItem Content="__InstanceOperationEvent" />
                                <ComboBoxItem Content="__ClassCreationEvent" />
                                <ComboBoxItem Content="__ClassModificationEvent" />
                                <ComboBoxItem Content="__ClassDeletionEvent" />
                            </ComboBox>
                        </GroupBox>

                        <!--  Target Class  -->
                        <GroupBox Margin="0" Header="Target Class">
                            <ComboBox Width="200"
                                      Height="26"
                                      VerticalContentAlignment="Center"
                                      IsEditable="True">
                                <ComboBoxItem Content="Win32_Process" />
                                <ComboBoxItem Content="Win32_Service" />
                                <ComboBoxItem Content="Win32_LogicalDisk" />
                            </ComboBox>
                        </GroupBox>

                        <!--  Within (sec)  -->
                        <GroupBox Margin="0" Header="Within (sec)">
                            <TextBox Width="40"
                                     Height="26"
                                     HorizontalContentAlignment="Center"
                                     Text="5" />
                        </GroupBox>

                    </StackPanel>

                    <!--  Event Query Row  -->
                    <GroupBox Grid.Row="1"
                              Grid.Column="0"
                              Margin="0"
                              HorizontalContentAlignment="Stretch"
                              BorderThickness="0"
                              Header="Event Query">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Custom Event Query CheckBox  -->
                            <CheckBox x:Name="OverrideQueryCheckBox"
                                      Grid.Column="0"
                                      Margin="4,4,4,4"
                                      VerticalAlignment="Center"
                                      Content="Custom" />

                            <!--  Custom Event Query TextBox  -->
                            <TextBox Grid.Column="1"
                                     Height="28"
                                     VerticalContentAlignment="Center"
                                     AcceptsReturn="True"
                                     IsReadOnly="{Binding IsChecked, ElementName=OverrideQueryCheckBox, Converter={StaticResource NotBoolToVisibilityConverter}}"
                                     Text="SELECT * FROM __InstanceCreationEvent WITHIN 5 WHERE TargetInstance ISA 'Win32_Process'"
                                     TextWrapping="Wrap" />

                            <!--  Add Watcher Button  -->
                            <Button Grid.Column="2"
                                    Width="100"
                                    Height="28"
                                    Content="Add Watcher" />

                        </Grid>
                    </GroupBox>
                </Grid>
            </GroupBox>

        </Grid>

        <!--  Main Content Panel: Split with GridSplitter  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left Panel: Watchers List  -->
            <GroupBox Grid.Column="0"
                      Margin="4"
                      HorizontalContentAlignment="Stretch"
                      VerticalContentAlignment="Stretch"
                      Header="Watchers">
                <DockPanel>
                    <ListView Height="Auto"
                              Margin="{StaticResource MarginTiny}"
                              BorderThickness="0"
                              Style="{StaticResource ModernGridListViewStyle}">
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style BasedOn="{StaticResource FlatGridViewColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                </GridView.ColumnHeaderContainerStyle>
                                <GridViewColumn Width="50" Header="State">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Ellipse Width="14" Height="14" Fill="{DynamicResource SuccessBrush}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding EventType}" Header="Event Type" />
                                <GridViewColumn Width="160" DisplayMemberBinding="{Binding ClassName}" Header="Class Name" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>

            <!--  GridSplitter  -->
            <GridSplitter Grid.Column="1"
                          Margin="0"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Stretch" />

            <!--  Right Panel: Events  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <GroupBox Grid.Row="0"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          Header="Event Filter">
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <ComboBox Width="180"
                                  Height="26"
                                  Margin="4"
                                  IsEditable="False">
                            <ComboBoxItem Content="Watcher 1" />
                            <ComboBoxItem Content="Watcher 2" />
                        </ComboBox>
                        <Button Width="100" Height="28" Content="Clear Events" />
                    </StackPanel>
                </GroupBox>

                <GroupBox Grid.Row="1"
                          HorizontalContentAlignment="Stretch"
                          VerticalContentAlignment="Stretch"
                          BorderThickness="1"
                          Header="Events">
                    <DataGrid AlternatingRowBackground="{DynamicResource TertiaryBackgroundBrush}"
                              AutoGenerateColumns="False"
                              Background="{DynamicResource PrimaryBackgroundBrush}"
                              BorderThickness="0"
                              GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column"
                              HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                              IsReadOnly="True"
                              RowBackground="Transparent">
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundBrush}" />
                                <Setter Property="Padding" Value="{StaticResource PaddingSmall}" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Timestamp}" Header="Timestamp" />
                            <DataGridTextColumn Width="*" Binding="{Binding EventType}" Header="Event Type" />
                            <DataGridTextColumn Width="1.5*" Binding="{Binding Details}" Header="Details" />
                        </DataGrid.Columns>
                    </DataGrid>
                </GroupBox>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
