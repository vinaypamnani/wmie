<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.ClassesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:WmiExplorer.Presentation.ViewModels.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             mc:Ignorable="d">

    <Grid x:Name="ClassesGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SettingsManager.MainWindowPosition.ClassesColumnGridLength, Mode=TwoWay}" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!--  Classes View Content  -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Expander Name="ExpanderClasses"
                      Padding="{StaticResource PaddingTopSmall}"
                      BorderThickness="0"
                      ExpandDirection="Right"
                      Header="Classes"
                      IsExpanded="{Binding SettingsManager.MainWindowPosition.IsClassesExpanded, Mode=TwoWay}"
                      Style="{StaticResource VerticalHeaderExpanderStyle}">
                <Expander.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <GroupBox Grid.Row="0"
                                  Margin="4,0,0,4"
                                  HorizontalContentAlignment="Stretch"
                                  Background="{DynamicResource SecondaryBackgroundBrush}"
                                  Header="SMS Provider Filters">
                            <GroupBox.Visibility>
                                <MultiBinding Converter="{StaticResource MultiBooleanAndToVisibilityConverter}">
                                    <Binding Path="SelectionManager.SelectedNamespace.IsSmsProviderNamespace" />
                                    <Binding Converter="{StaticResource NullToBoolConverter}" Path="SelectionManager.SelectedNamespace" />
                                </MultiBinding>
                            </GroupBox.Visibility>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <CheckBox Grid.Row="0"
                                          Grid.Column="0"
                                          HorizontalAlignment="Left"
                                          Content="Include Collection Classes"
                                          IsChecked="{Binding SettingsManager.ConfigMgrSettings.IncludeCollectionClasses, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Tooltip.ClassesTab.IncludeCollectionClasses}" />
                                <CheckBox Grid.Row="1"
                                          Grid.Column="0"
                                          HorizontalAlignment="Left"
                                          Content="Include Inventory Classes"
                                          IsChecked="{Binding SettingsManager.ConfigMgrSettings.IncludeInventoryClasses, Mode=TwoWay}"
                                          ToolTip="{DynamicResource Tooltip.ClassesTab.IncludeInventoryClasses}" />
                                <Button Grid.Row="0"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Margin="{DynamicResource MarginLeftSmall}"
                                        Command="{Binding SelectionManager.SelectedNamespace.LoadClassesCommand}"
                                        Content="Reload"
                                        ToolTip="{DynamicResource Tooltip.ClassesTab.ReloadClasses}" />
                            </Grid>
                        </GroupBox>
                        <CheckBox Grid.Row="1"
                                  HorizontalAlignment="Right"
                                  IsChecked="{Binding SettingsManager.ShowSystemClasses, Mode=TwoWay}"
                                  ToolTip="{DynamicResource Tooltip.ClassesTab.ShowSystemClasses}">
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Show System Classes" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectionManager.SelectedNamespace.SystemClassesCount, Converter={StaticResource NullToBoolConverter}}" Value="True">
                                                <Setter Property="Text" Value="{Binding SelectionManager.SelectedNamespace.SystemClassesCount, StringFormat='Show System Classes [{0}]'}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </CheckBox>
                        <TextBox Grid.Row="2"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource TextBoxWithClearButton}"
                                 Tag="Filter Classes..."
                                 Text="{Binding SelectionManager.SelectedNamespace.ClassFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView Grid.Row="3"
                                  behaviors:ListViewAutoScrollBehavior.AutoScroll="False"
                                  behaviors:ListViewAutoScrollBehavior.SelectedItemMonitor="{Binding SelectionManager.SelectedNamespace.SelectedClass}"
                                  behaviors:ListViewSortBehavior.DefaultSortProperty="ClassName"
                                  behaviors:ListViewSortBehavior.EnableSorting="True"
                                  ItemsSource="{Binding SelectionManager.SelectedNamespace.ClassesView}"
                                  SelectedItem="{Binding SelectionManager.SelectedNamespace.SelectedClass}"
                                  SelectionMode="Single"
                                  Style="{StaticResource ModernGridListViewStyle}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource ModernGridViewColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200" behaviors:ListViewSortBehavior.SortProperty="ClassName" Header="Class Name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,1,0,1" Orientation="Horizontal">
                                                    <ContentControl Margin="0,0,4,0"
                                                                    Content="{Binding}"
                                                                    ContentTemplate="{StaticResource CircleIconWithStateTemplate}"
                                                                    ToolTip="{Binding Tooltip}" />
                                                    <TextBlock Text="{Binding ClassName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="300" behaviors:ListViewSortBehavior.SortProperty="Description" Header="Description">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="Auto"
                                                           MaxHeight="20"
                                                           Text="{Binding Description}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.InputBindings>
                                <KeyBinding Key="F5" Command="{Binding SelectionManager.SelectedNamespace.SelectedClass.LoadInstancesCommand}" />
                                <KeyBinding Key="Enter" Command="{Binding SelectionManager.SelectedNamespace.SelectedClass.LoadInstancesCommand}" />
                            </ListView.InputBindings>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ModernGridListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                                    <Setter Property="behaviors:ItemDoubleClickBehavior.Command" Value="{Binding LoadInstancesCommand}" />
                                    <!--  ContextMenu for Copy Relative Path and Cancel loading  -->
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding LoadInstancesCommand}"
                                                          CommandParameter="{Binding}"
                                                          FontWeight="Bold"
                                                          Header="Load Instances"
                                                          InputGestureText="F5">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource LoadIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="{Binding CancelInstanceLoadCommand}" CommandParameter="{Binding}" Header="Cancel loading">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource StopIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="{Binding CreateInstanceCommand}" Header="Create instance">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource AddIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                                <MenuItem Command="{Binding ShowClassMofCommand}" CommandParameter="True" Header="Show MOF (with amended qualifiers)">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource ShowResultsIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="{Binding ShowClassMofCommand}" CommandParameter="False" Header="Show MOF (without amended qualifiers)">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource OpenInNewwindowIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                                <MenuItem Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding}" Header="Copy Relative Path">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="{Binding CopyClassMofCommand}" CommandParameter="True" Header="Copy MOF (with amended qualifiers)">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource CopyMofIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Command="{Binding CopyClassMofCommand}" CommandParameter="False" Header="Copy MOF (without amended qualifiers)">
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource CopyMofSimpleIconTemplate}" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                                <MenuItem ItemsSource="{Binding StaticMethods}">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Execute Static Methods" />
                                                            <TextBlock Text="{Binding StaticMethods.Count, StringFormat='[{0}]'}" />
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                    <MenuItem.Icon>
                                                        <ContentControl ContentTemplate="{StaticResource ExecMethodIconTemplate}" />
                                                    </MenuItem.Icon>
                                                    <MenuItem.Style>
                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding StaticMethods.Count}" Value="0">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Name}" />
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                            <Setter Property="Command" Value="{Binding DataContext.ExecuteMethodCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIcon" Value="C" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIconToolTip" Value="Static (Class) Method" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIconBackground" Value="{DynamicResource BaseBlueBrush}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Expander.Content>
            </Expander>
        </Grid>

        <GridSplitter Grid.Row="0"
                      Grid.Column="1"
                      Margin="0,4,0,0"
                      Visibility="{Binding SettingsManager.MainWindowPosition.IsClassesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

        <Border Grid.Column="2"
                Margin="{DynamicResource MarginLeftSmall}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0"
                CornerRadius="3">
            <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                <TabItem Header="{Binding InstancesTabHeader}" TabIndex="0">
                    <!--  Instances View  -->
                    <tabs:InstancesTabView DataContext="{Binding InstancesTabViewModel}" />
                </TabItem>
                <TabItem Header="{Binding PropertiesTabHeader}" TabIndex="1">
                    <!--  Properties View  -->
                    <tabs:PropertiesTabView DataContext="{Binding PropertiesTabViewModel}" />
                </TabItem>
                <TabItem Header="{Binding MethodsTabHeader}" TabIndex="2">
                    <!--  Methods View  -->
                    <tabs:MethodsTabView DataContext="{Binding MethodsTabViewModel}" />
                </TabItem>
            </TabControl>
        </Border>

        <!--  Query GroupBox spanning all columns - override Style margin  -->
        <GroupBox Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Margin="{DynamicResource MarginBottomSmall}"
                  HorizontalContentAlignment="Stretch"
                  Header="Auto-generated Query for selected class or instance">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         IsReadOnly="True"
                         Style="{StaticResource TextBoxWithPlaceholder}"
                         Tag="Automatically created query..."
                         Text="{Binding AutoQueryText, Mode=OneWay}" />
                <Button Grid.Column="1"
                        MinWidth="75"
                        Command="{Binding ExecuteAutoQueryCommand}"
                        Content="Execute" />
            </Grid>
        </GroupBox>
    </Grid>

</UserControl>
