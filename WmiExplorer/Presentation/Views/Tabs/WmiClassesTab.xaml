<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.WmiClassesTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid x:Name="ClassesGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding WindowPosition.ClassesColumnGridLength, Mode=TwoWay}" />
            <ColumnDefinition Width="Auto" />
            <!--  Changed from fixed 15px to Auto  -->
            <ColumnDefinition Width="2*" />
        </Grid.ColumnDefinitions>

        <!--  Classes View Content  -->
        <Grid Grid.Row="0" Grid.Column="0">
            <Expander Name="ExpanderClasses"
                      Padding="{StaticResource PaddingTopSmall}"
                      BorderThickness="0"
                      ExpandDirection="Right"
                      IsExpanded="{Binding WindowPosition.IsClassesExpanded, Mode=TwoWay}"
                      Style="{StaticResource VerticalHeaderExpanderStyle}">
                <Expander.Header>
                    <Border Width="25">
                        <TextBlock FontSize="15" FontWeight="Light" Text="Classes">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90" />
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>
                </Expander.Header>
                <Expander.Content>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <CheckBox Grid.Row="0"
                                  Margin="{StaticResource MarginSmall}"
                                  HorizontalAlignment="Right"
                                  Content="Show System Classes"
                                  IsChecked="{Binding ShowSystemClasses, Mode=TwoWay}" />
                        <TextBox Grid.Row="1"
                                 VerticalAlignment="Center"
                                 Style="{StaticResource TextBoxWithClearButton}"
                                 Tag="Filter Classes..."
                                 Text="{Binding SelectedNamespace.ClassFilterText, UpdateSourceTrigger=PropertyChanged}" />
                        <ListView Grid.Row="2"
                                  behaviors:ListViewAutoScrollBehavior.AutoScroll="True"
                                  behaviors:ListViewAutoScrollBehavior.SelectedItemMonitor="{Binding SelectedNamespace.SelectedClass}"
                                  behaviors:ListViewSortBehavior.DefaultSortProperty="ClassName"
                                  behaviors:ListViewSortBehavior.EnableSorting="True"
                                  BorderThickness="0"
                                  ItemsSource="{Binding SelectedNamespace.ClassesView}"
                                  SelectedItem="{Binding SelectedNamespace.SelectedClass}"
                                  SelectionMode="Single"
                                  Style="{StaticResource ModernGridListViewStyle}">
                            <ListView.View>
                                <GridView AllowsColumnReorder="True">
                                    <GridView.ColumnHeaderContainerStyle>
                                        <Style BasedOn="{StaticResource ModernGridViewColumnHeaderStyle}" TargetType="GridViewColumnHeader" />
                                    </GridView.ColumnHeaderContainerStyle>
                                    <GridViewColumn Width="200" behaviors:ListViewSortBehavior.SortProperty="ClassName" Header="Class Name">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Grid Width="16" Height="16" Margin="{StaticResource MarginTiny}">
                                                        <Ellipse Width="10"
                                                                 Height="10"
                                                                 RenderTransformOrigin="0.5,0.5"
                                                                 Style="{DynamicResource StatusIndicatorStyle}" />
                                                    </Grid>
                                                    <TextBlock Margin="{StaticResource MarginHorizontalSmall}" Text="{Binding ClassName}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Width="300" behaviors:ListViewSortBehavior.SortProperty="Description" Header="Description">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Width="Auto"
                                                           MaxHeight="20"
                                                           Margin="{StaticResource MarginHorizontalSmall}"
                                                           Text="{Binding Description}"
                                                           TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Description}" Value="">
                                                                    <Setter Property="ToolTip" Value="{x:Null}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                            <ListView.ItemContainerStyle>
                                <Style BasedOn="{StaticResource ModernGridListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                                    <Setter Property="behaviors:ListViewItemDoubleClickBehavior.Command" Value="{Binding LoadInstancesCommand}" />
                                    <Setter Property="behaviors:ListViewItemSelectionBehavior.EnableForceSelection" Value="True" />
                                    <!--  ContextMenu for Copy Relative Path and Cancel loading  -->
                                    <Setter Property="ContextMenu">
                                        <Setter.Value>
                                            <ContextMenu>
                                                <MenuItem Command="{Binding CopyRelativePathCommand}" CommandParameter="{Binding}" Header="Copy Relative Path" />
                                                <MenuItem Command="{Binding CancelInstanceLoadCommand}" CommandParameter="{Binding}" Header="Cancel loading" />
                                                <MenuItem ItemsSource="{Binding ClassMethods}">
                                                    <MenuItem.Header>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Execute Static Methods" />
                                                            <TextBlock Margin="4,0,0,0" Text="{Binding ClassMethods.Count, StringFormat='[{0}]'}" />
                                                        </StackPanel>
                                                    </MenuItem.Header>
                                                    <MenuItem.Style>
                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ClassMethods.Count}" Value="0">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </MenuItem.Style>
                                                    <MenuItem.ItemContainerStyle>
                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding Name}" />
                                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                                        </Style>
                                                    </MenuItem.ItemContainerStyle>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </Grid>
                </Expander.Content>
            </Expander>
        </Grid>
        <GridSplitter Grid.Row="0"
                      Grid.Column="1"
                      Width="{StaticResource SpacingMedium}"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch"
                      Visibility="{Binding WindowPosition.IsClassesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

        <TabControl Grid.Row="0" Grid.Column="2">
            <TabItem Header="Instances">
                <!--  Instances View  -->
                <tabs:WmiInstancesTab />
            </TabItem>
            <TabItem Header="Properties">
                <!--  Properties View  -->
                <tabs:WmiPropertiesTab />
            </TabItem>
            <TabItem Header="Methods">
                <!--  Methods View  -->
                <tabs:WmiMethodsTab />
            </TabItem>
        </TabControl>

        <!--  Query GroupBox spanning all columns  -->
        <GroupBox Grid.Row="1"
                  Grid.ColumnSpan="3"
                  Margin="{StaticResource MarginTopSmall}"
                  HorizontalContentAlignment="Stretch"
                  Header="Query">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0"
                         Margin="{StaticResource MarginSmall}"
                         IsReadOnly="True"
                         Style="{StaticResource TextBoxWithPlaceholder}"
                         Tag="Automatically created query..."
                         Text="{Binding AutoQueryText, Mode=OneWay}" />
                <Button Grid.Column="1"
                        MinWidth="75"
                        Margin="{StaticResource MarginSmall}"
                        Command="{Binding ExecuteAutoQueryCommand}"
                        Content="Execute" />
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
