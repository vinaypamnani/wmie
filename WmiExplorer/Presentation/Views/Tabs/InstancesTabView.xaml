<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.InstancesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:WmiExplorer.Presentation.ViewModels.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBox Grid.Row="0"
                 Margin="{DynamicResource MarginBottomSmall}"
                 VerticalAlignment="Center"
                 Style="{StaticResource TextBoxWithClearButton}"
                 Tag="Filter Instances..."
                 Text="{Binding SelectionManager.SelectedNamespace.SelectedClass.InstanceFilterText, UpdateSourceTrigger=PropertyChanged}" />

        <ListView Grid.Row="1"
                  Margin="{DynamicResource MarginBottomSmall}"
                  behaviors:ListViewAutoScrollBehavior.AutoScroll="False"
                  behaviors:ListViewAutoScrollBehavior.SelectedItemMonitor="{Binding SelectionManager.SelectedNamespace.SelectedClass.SelectedInstance}"
                  ItemsSource="{Binding SelectionManager.SelectedNamespace.SelectedClass.InstancesView}"
                  SelectedItem="{Binding SelectionManager.SelectedNamespace.SelectedClass.SelectedInstance}"
                  SelectionMode="Single"
                  Style="{StaticResource ModernListViewStyle}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource ModernListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Command="{Binding EditPropertiesCommand}" Header="Edit Properties...">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource EditIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                <MenuItem Command="{Binding ShowInstanceMofCommand}" CommandParameter="True" Header="Show MOF (with amended qualifiers)">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource ShowResultsIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding ShowInstanceMofCommand}" CommandParameter="False" Header="Show MOF (without amended qualifiers)">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource OpenInNewwindowIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                <MenuItem Command="{Binding CopyRelativePathCommand}" Header="Copy Relative Path">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding CopyInstanceMofCommand}" CommandParameter="True" Header="Copy MOF (with amended qualifiers)">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource CopyMofIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Command="{Binding CopyInstanceMofCommand}" CommandParameter="False" Header="Copy MOF (without amended qualifiers)">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource CopyMofSimpleIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                <MenuItem ItemsSource="{Binding InstanceMethods}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Execute Methods" />
                                            <TextBlock Text="{Binding InstanceMethods.Count, StringFormat='[{0}]'}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource ExecMethodIconTemplate}" />
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InstanceMethods.Count}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                    <MenuItem.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ExecuteMethodCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                            <Setter Property="helpers:LetterIconHelper.LetterIcon" Value="I" />
                                            <Setter Property="helpers:LetterIconHelper.LetterIconToolTip" Value="Non-Static (Instance) Method" />
                                            <Setter Property="helpers:LetterIconHelper.LetterIconBackground" Value="{DynamicResource BaseGreenBrush}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,1,0,1" Orientation="Horizontal">
                        <ContentControl Margin="0,0,4,0" Content="{Binding}" ContentTemplate="{StaticResource CircleIconWithStateTemplate}" />
                        <TextBlock Text="{Binding InstanceName}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
