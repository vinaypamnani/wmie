<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.InstancesTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="{StaticResource MarginSmall}">
            <TextBox VerticalAlignment="Center"
                     Style="{StaticResource TextBoxWithClearButton}"
                     Tag="Filter Instances..."
                     Text="{Binding SelectionManager.SelectedNamespace.SelectedClass.InstanceFilterText, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>
        <ListView Grid.Row="1"
                  behaviors:ListViewAutoScrollBehavior.AutoScroll="False"
                  behaviors:ListViewAutoScrollBehavior.SelectedItemMonitor="{Binding SelectionManager.SelectedNamespace.SelectedClass.SelectedInstance}"
                  BorderThickness="0"
                  ItemsSource="{Binding SelectionManager.SelectedNamespace.SelectedClass.InstancesView}"
                  SelectedItem="{Binding SelectionManager.SelectedNamespace.SelectedClass.SelectedInstance}"
                  SelectionMode="Single"
                  Style="{StaticResource ModernListViewStyle}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource ModernListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Command="{Binding EditPropertiesCommand}" Header="Edit Properties...">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource EditIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator Style="{StaticResource ModernSeparatorStyle}" />
                                <MenuItem Command="{Binding CopyRelativePathCommand}" Header="Copy Relative Path">
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem ItemsSource="{Binding InstanceMethods}">
                                    <MenuItem.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Execute Methods" />
                                            <TextBlock Margin="4,0,0,0" Text="{Binding InstanceMethods.Count, StringFormat='[{0}]'}" />
                                        </StackPanel>
                                    </MenuItem.Header>
                                    <MenuItem.Icon>
                                        <ContentControl ContentTemplate="{StaticResource ExecMethodIconTemplate}" />
                                    </MenuItem.Icon>
                                    <MenuItem.Style>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="{x:Type MenuItem}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding InstanceMethods.Count}" Value="0">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </MenuItem.Style>
                                    <MenuItem.ItemContainerStyle>
                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                            <Setter Property="Header" Value="{Binding Name}" />
                                            <Setter Property="ToolTip" Value="{Binding Description}" />
                                            <Setter Property="Command" Value="{Binding DataContext.ExecuteMethodCommand, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type ContextMenu}}}" />
                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                        </Style>
                                    </MenuItem.ItemContainerStyle>
                                </MenuItem>
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="{StaticResource MarginTiny}">
                            <Ellipse Width="10"
                                     Height="10"
                                     RenderTransformOrigin="0.5,0.5"
                                     Style="{DynamicResource StatusIndicatorStyle}" />
                        </Grid>
                        <TextBlock Margin="{StaticResource MarginTiny}" Text="{Binding InstanceName}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
