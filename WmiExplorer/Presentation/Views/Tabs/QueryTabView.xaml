<UserControl x:Class="WmiExplorer.Presentation.Views.Tabs.QueryTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:avalonbehaviors="clr-namespace:WmiExplorer.Integration.AvalonEdit.Behaviors"
             xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             mc:Ignorable="d">
    <Grid x:Name="QueryGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <!--  Query GroupBox  -->
        <GroupBox Grid.Row="0" HorizontalContentAlignment="Stretch" Header="Query">
            <DockPanel LastChildFill="True">
                <Grid DockPanel.Dock="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Query Options  -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <CheckBox Content="DirectRead" IsChecked="{Binding DirectRead}" ToolTip="{StaticResource Tooltip.Query.DirectAccess}" />
                        <CheckBox Content="UseAmendedQualifiers" IsChecked="{Binding UseAmendedQualifiers}" ToolTip="{StaticResource Tooltip.Query.UseAmendedQualifiers}" />
                    </StackPanel>
                    <!--  Action Buttons  -->
                    <Button Grid.Column="1"
                            Width="90"
                            Command="{Binding ExecuteQueryCommand}"
                            Content="Execute"
                            IsDefault="True"
                            IsEnabled="{Binding Converter={StaticResource NullToBoolConverter}}"
                            ToolTip="{StaticResource Tooltip.Query.Execute}" />
                    <Button Grid.Column="2"
                            Width="90"
                            Command="{Binding CancelQueryCommand}"
                            Content="Cancel"
                            IsEnabled="{Binding Converter={StaticResource NullToBoolConverter}}"
                            ToolTip="{StaticResource Tooltip.Query.Cancel}" />
                </Grid>

                <!--  Query Editor  -->
                <Border Margin="4"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0"
                        CornerRadius="2"
                        DockPanel.Dock="Top">
                    <avalonedit:TextEditor MinHeight="80"
                                           Padding="0,4,0,0"
                                           avalonbehaviors:AvalonEditCompletionBehavior.CacheService="{Binding CacheService}"
                                           avalonbehaviors:AvalonEditCompletionBehavior.EnableCompletion="True"
                                           avalonbehaviors:AvalonEditCompletionBehavior.Namespace="{Binding SelectionManager.SelectedNamespace.NamespacePath}"
                                           avalonbehaviors:AvalonEditTextBindingBehavior.BoundText="{Binding QueryText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                           avalonbehaviors:AvalonEditThemingBehavior.EnableTheming="True"
                                           avalonbehaviors:AvalonEditWqlHighlightingBehavior.EnableWqlHighlighting="True"
                                           Background="{DynamicResource PrimaryBackgroundBrush}"
                                           DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           FontFamily="Consolas, Courier New, Monospace"
                                           FontSize="14"
                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                           HorizontalScrollBarVisibility="Auto"
                                           LineNumbersForeground="{DynamicResource SecondaryForegroundBrush}"
                                           ShowLineNumbers="True"
                                           VerticalScrollBarVisibility="Auto" />
                </Border>
            </DockPanel>
        </GroupBox>

        <!--  Results GroupBox  -->
        <GroupBox Grid.Row="1"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Header="Query Results">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Filter TextBox  -->
                <Grid Grid.Row="0" Margin="{DynamicResource MarginVerticalSmall}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0"
                             Height="26"
                             Style="{StaticResource TextBoxWithClearButton}"
                             Tag="Filter results..."
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="{StaticResource Tooltip.Query.FilterResults}" />

                    <Button Grid.Column="1"
                            Width="80"
                            Command="{Binding ClearResultsCommand}"
                            Content="Clear Results"
                            ToolTip="{StaticResource Tooltip.Query.ClearResults}" />
                </Grid>
                <!--  Results DataGrid  -->
                <DataGrid x:Name="ResultsDataGrid"
                          Grid.Row="1"
                          Background="{DynamicResource PrimaryBackgroundBrush}"
                          ItemsSource="{Binding ResultsView}"
                          SelectedItem="{Binding SelectedResult, Mode=TwoWay}"
                          Style="{StaticResource ModernDataGridStyle}">
                    <DataGrid.Resources>
                        <Style BasedOn="{StaticResource ModernScrollBarStyle}" TargetType="ScrollBar" />
                    </DataGrid.Resources>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
