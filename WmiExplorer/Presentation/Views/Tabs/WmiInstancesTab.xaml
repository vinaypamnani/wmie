<UserControl
    x:Class="WmiExplorer.Presentation.Views.Tabs.WmiInstancesTab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <DockPanel Grid.Row="0" Margin="{StaticResource MarginSmall}">
            <TextBox
                VerticalAlignment="Center"
                Style="{StaticResource TextBoxWithClearButton}"
                Tag="Filter Instances..."
                Text="{Binding SelectedNamespace.SelectedClass.QuickFilterInstances, UpdateSourceTrigger=PropertyChanged}" />
        </DockPanel>

        <ListView
            Grid.Row="1"
            BorderThickness="0"
            ItemsSource="{Binding SelectedNamespace.SelectedClass.WmiInstancesView}"
            SelectedItem="{Binding SelectedNamespace.SelectedClass.SelectedInstance}"
            SelectionMode="Single"
            Style="{StaticResource ScrollableListViewStyle}">
            <ListView.ItemContainerStyle>
                <Style BasedOn="{StaticResource BaseListViewItemStyle}" TargetType="{x:Type ListViewItem}">
                    <Setter Property="behaviors:ListViewItemSelectionBehavior.EnableForceSelection" Value="True" />
                    <Setter Property="ContextMenu">
                        <Setter.Value>
                            <ContextMenu>
                                <MenuItem Command="{Binding CopyRelativePathCommand}" Header="Copy Relative Path" />
                            </ContextMenu>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="{StaticResource MarginTiny}" Text="{Binding InstanceName}" />
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
