<UserControl x:Class="WmiExplorer.Presentation.Views.Main.NamespacesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:helpers="clr-namespace:WmiExplorer.Presentation.ViewModels.Helpers"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="300"
             Background="{DynamicResource PrimaryBackgroundBrush}"
             mc:Ignorable="d">

    <Grid>
        <Expander Name="ExpanderNamespaces"
                  Padding="{StaticResource PaddingTopSmall}"
                  BorderThickness="0"
                  ExpandDirection="Right"
                  Header="Namespaces"
                  IsExpanded="{Binding SettingsManager.MainWindowPosition.IsNamespacesExpanded, Mode=TwoWay}"
                  Style="{StaticResource VerticalHeaderExpanderStyle}">

            <TreeView Name="WmiNamespaces"
                      Margin="0,0,4,4"
                      behaviors:TreeViewAutoScrollBehavior.AutoScroll="True"
                      ItemsSource="{Binding Namespaces}">
                <TreeView.ItemContainerStyle>
                    <Style BasedOn="{StaticResource ModernTreeViewItemStyle}" TargetType="{x:Type TreeViewItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="behaviors:ItemSelectionBehavior.EnableForceSelection" Value="True" />
                        <Setter Property="behaviors:ItemDoubleClickBehavior.Command" Value="{Binding LoadClassesCommand}" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu>
                                    <MenuItem Command="{Binding LoadClassesCommand}" FontWeight="Bold" Header="Load Classes">
                                        <MenuItem.Icon>
                                            <ContentControl ContentTemplate="{StaticResource LoadIconTemplate}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Command="{Binding CopyRelativePathCommand}" Header="Copy Relative Path">
                                        <MenuItem.Icon>
                                            <ContentControl ContentTemplate="{StaticResource CopyIconTemplate}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator Style="{StaticResource ModernSeparatorStyle}" Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <MenuItem Command="{Binding DisconnectCommand}" Header="Disconnect" Visibility="{Binding IsRoot, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <MenuItem.Icon>
                                            <ContentControl ContentTemplate="{StaticResource DisconnectIconTemplate}" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <!--  ConfigMgr Client Actions context menu, only for SMS Client namespaces and if installed  -->
                                    <MenuItem Header="ConfigMgr Client Actions" Visibility="{Binding IsSmsClientInstalled, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <MenuItem.ItemsSource>
                                            <Binding Path="GroupedClientActions" />
                                        </MenuItem.ItemsSource>
                                        <MenuItem.Icon>
                                            <ContentControl ContentTemplate="{StaticResource ConfigMgrClientIconTemplate}" />
                                        </MenuItem.Icon>
                                        <MenuItem.ItemContainerStyle>
                                            <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                <Setter Property="Header" Value="{Binding Path=Key}" />
                                                <Setter Property="ItemsSource" Value="{Binding}" />
                                                <Setter Property="helpers:LetterIconHelper.LetterIcon" Value="G" />
                                                <Setter Property="helpers:LetterIconHelper.LetterIconBackground" Value="{DynamicResource BaseGreenBrush}" />
                                                <Setter Property="helpers:LetterIconHelper.LetterIconToolTip" Value="Client Action Group" />
                                                <Setter Property="ItemContainerStyle">
                                                    <Setter.Value>
                                                        <Style BasedOn="{StaticResource {x:Type MenuItem}}" TargetType="MenuItem">
                                                            <Setter Property="Header" Value="{Binding DisplayName}" />
                                                            <Setter Property="Command" Value="{Binding DataContext.TriggerClientActionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Setter Property="CommandParameter" Value="{Binding}" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIcon" Value="A" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIconBackground" Value="{DynamicResource BaseBlueBrush}" />
                                                            <Setter Property="helpers:LetterIconHelper.LetterIconToolTip" Value="Client Action" />
                                                        </Style>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </MenuItem.ItemContainerStyle>
                                    </MenuItem>
                                </ContextMenu>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Margin="0,1,0,1" Orientation="Horizontal">
                            <ContentControl x:Name="IconContent"
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Content="{Binding}">
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <Setter Property="ContentTemplate" Value="{DynamicResource StatusIndicatorStyle}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsRoot}" Value="True">
                                                <Setter Property="ContentTemplate" Value="{DynamicResource ConnectionOptionsIconTemplate}" />
                                                <Setter Property="Margin" Value="0,0,4,0" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRoot}" Value="False">
                                                <Setter Property="ContentTemplate">
                                                    <Setter.Value>
                                                        <DataTemplate>
                                                            <Ellipse Width="10"
                                                                     Height="10"
                                                                     RenderTransformOrigin="0.5,0.5"
                                                                     Style="{DynamicResource StatusIndicatorStyle}" />
                                                        </DataTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                            <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Expander>

    </Grid>

</UserControl>
