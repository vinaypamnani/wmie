<UserControl
    x:Class="WmiExplorer.Presentation.Views.Main.StatusIndicator"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:WmiExplorer.Presentation.Converters"
    xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Main"
    xmlns:services="clr-namespace:WmiExplorer.Services"
    xmlns:shared="clr-namespace:WmiExplorer.Common.Shared"
    xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
    Width="20"
    Height="20">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolAndNotBoolToVisibilityConverter x:Key="BoolAndNotBoolToVisibilityConverter" />
        <converters:NotBoolAndNotBoolToVisibilityConverter x:Key="NotBoolAndNotBoolToVisibilityConverter" />

        <!--  Animations  -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetName="BusyEllipse"
                Storyboard.TargetProperty="Opacity"
                From="1.0"
                To="0.6"
                Duration="0:0:0.75" />
        </Storyboard>

        <Storyboard x:Key="IndeterminateStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation
                AutoReverse="True"
                Storyboard.TargetName="IndeterminateEllipse"
                Storyboard.TargetProperty="Opacity"
                From="1.0"
                To="0.3"
                Duration="0:0:1.5" />
        </Storyboard>
    </UserControl.Resources>
    <Border
        Padding="{StaticResource PaddingTiny}"
        Background="{DynamicResource BorderBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="10">
        <Grid>
            <!--  Indeterminate Indicator (Gray)  -->
            <Ellipse
                x:Name="IndeterminateEllipse"
                Width="14"
                Height="14"
                Fill="{DynamicResource IndeterminateBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Indeterminate}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource IndeterminateStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!--  Busy Indicator (Blue)  -->
            <Ellipse
                x:Name="BusyEllipse"
                Width="14"
                Height="14"
                Fill="{DynamicResource BusyBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>

            <!--  Error Indicator (Red)  -->
            <Ellipse Width="14" Height="14" Fill="{DynamicResource ErrorBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!--  Success Indicator (Green)  -->
            <Ellipse Width="14" Height="14" Fill="{DynamicResource SuccessBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Success}" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>

            <!--  Ready/Idle Indicator (Green)  -->
            <Ellipse Width="14" Height="14" Fill="{DynamicResource SuccessBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Ready}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>
    </Border>
</UserControl>
