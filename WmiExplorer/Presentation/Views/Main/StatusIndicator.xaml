<UserControl x:Class="WmiExplorer.Presentation.Views.Main.StatusIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:WmiExplorer.Presentation.Converters"
             xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Main"
             xmlns:services="clr-namespace:WmiExplorer.Services"
             xmlns:shared="clr-namespace:WmiExplorer.Common.Shared"
             xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
             Width="100"
             Height="20">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolAndNotBoolToVisibilityConverter x:Key="BoolAndNotBoolToVisibilityConverter" />
        <converters:NotBoolAndNotBoolToVisibilityConverter x:Key="NotBoolAndNotBoolToVisibilityConverter" />
        <!--  Animations  -->
        <Storyboard x:Key="PulseStoryboard" RepeatBehavior="Forever">
            <DoubleAnimation AutoReverse="True"
                             Storyboard.TargetProperty="Opacity"
                             From="1.0"
                             To="0.3"
                             Duration="0:0:1.5" />
        </Storyboard>
        <!--  Progress Bar Animation - For 100px control with full-width progress track  -->
        <Storyboard x:Key="ProgressBarAnimation" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetName="ProgressBarTransform"
                             Storyboard.TargetProperty="X"
                             From="-58"
                             To="58"
                             Duration="0:0:1.2" />
        </Storyboard>
    </UserControl.Resources>
    <Border Padding="{StaticResource PaddingTiny}"
            Background="{DynamicResource BorderBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <!--  Busy Progress Bar - Full-width track spans entire 100px control  -->
            <Border x:Name="ProgressBarContainer"
                    Width="96"
                    Height="5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderBrush}"
                    ClipToBounds="True"
                    CornerRadius="2.5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Busy}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Border.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource ProgressBarAnimation}" />
                    </EventTrigger>
                </Border.Triggers>
                <Rectangle x:Name="ProgressBar"
                           Width="20"
                           Height="5"
                           Fill="{DynamicResource SecondaryAccentBrush}"
                           RadiusX="2.5"
                           RadiusY="2.5"
                           RenderTransformOrigin="0.5,0.5">
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="ProgressBarTransform" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Border>
            <!--  Indeterminate Indicator (Gray)  -->
            <Ellipse x:Name="IndeterminateEllipse"
                     Width="14"
                     Height="14"
                     Margin="0,0,2,0"
                     HorizontalAlignment="Right"
                     Fill="{DynamicResource IndeterminateBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Indeterminate}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <!--  Error Indicator (Red)  -->
            <Ellipse Width="14"
                     Height="14"
                     Margin="0,0,2,0"
                     HorizontalAlignment="Right"
                     Fill="{DynamicResource ErrorBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Error}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
            <!--  Ready/Success Indicator (Green)  -->
            <Ellipse Width="14"
                     Height="14"
                     Margin="0,0,2,0"
                     HorizontalAlignment="Right"
                     Fill="{DynamicResource SuccessBrush}">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Ready}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentApplicationState.State}" Value="{x:Static shared:AppState.Success}">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Ellipse.Loaded">
                        <BeginStoryboard Storyboard="{StaticResource PulseStoryboard}" />
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>
    </Border>
</UserControl>
