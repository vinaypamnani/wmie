<Window x:Class="WmiExplorer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
        xmlns:converters="clr-namespace:WmiExplorer.Presentation.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:main="clr-namespace:WmiExplorer.Presentation.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pg="clr-namespace:WmiExplorer.Presentation.Controls.PropertyGrid"
        xmlns:services="clr-namespace:WmiExplorer.Services"
        xmlns:shared="clr-namespace:WmiExplorer.Common.Shared"
        xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
        xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
        Title="WmiExplorer"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolAndNotBoolToVisibilityConverter x:Key="BoolAndNotBoolToVisibilityConverter" />
        <converters:NotBoolAndNotBoolToVisibilityConverter x:Key="NotBoolAndNotBoolToVisibilityConverter" />
        <converters:ApplicationStateToCursorConverter x:Key="ApplicationStateToCursorConverter" />
        <converters:EnumFlagsToBooleanConverter x:Key="EnumFlagsToBooleanConverter" />
    </Window.Resources>
    <Window.Cursor>
        <Binding Converter="{StaticResource ApplicationStateToCursorConverter}" Path="CurrentApplicationState" />
    </Window.Cursor>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <!--  Menu  -->
            <RowDefinition Height="Auto" />
            <!--  Application Content  -->
            <RowDefinition Height="*" />
            <!--  Status Bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="_File">
                <MenuItem Header="Load..." />
                <MenuItem Header="Save..." />
                <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cut" />
                <MenuItem Header="Copy" />
                <MenuItem Header="Paste" />
            </MenuItem>
            <TextBlock>
                <Hyperlink>Version</Hyperlink>
            </TextBlock>
            <MenuItem x:Name="ThemeToggle"
                      Margin="{StaticResource MarginHorizontalLarge}"
                      HorizontalAlignment="Right"
                      Command="{Binding ToggleThemeCommand}"
                      DockPanel.Dock="Right"
                      Header="{Binding ThemeToggleText, Mode=OneWay}" />
        </Menu>

        <Grid Name="ApplicationContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="{StaticResource MarginHorizontalSmall}" VerticalAlignment="Top">
                <main:OptionsPanel />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="{StaticResource MarginHorizontalSmall}">
                <Grid Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WindowPosition.NamespaceColumnGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.ContentColumnStarGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.PropertyGridColumnStarGridLength, Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <!--  Namespace View  -->
                    <main:WmiNamespacesPane Grid.Column="0" />

                    <GridSplitter Grid.Column="1"
                                  Width="{StaticResource SpacingMedium}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding WindowPosition.IsNamespacesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <TabControl Grid.Column="2">
                        <TabItem Header="Classes">
                            <!--  All the grid content has been moved to WmiClassesTab  -->
                            <tabs:WmiClassesTab />
                        </TabItem>
                        <TabItem Header="Search">
                            <!--  Search View  -->
                            <tabs:WmiSearchTab />
                        </TabItem>
                        <TabItem Header="Watcher">
                            <!--  Event Watcher View  -->
                            <tabs:WmiEventWatcherTab />
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Column="3"
                                  Width="{StaticResource SpacingMedium}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding WindowPosition.IsPropertyGridExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />
                    <!--  Property Grid with Expander  -->
                    <Grid Grid.Column="4">
                        <Expander Name="ExpanderPropertyGrid"
                                  Padding="{StaticResource PaddingTopSmall}"
                                  BorderThickness="0"
                                  ExpandDirection="Left"
                                  IsExpanded="{Binding WindowPosition.IsPropertyGridExpanded, Mode=TwoWay}"
                                  Style="{StaticResource VerticalHeaderExpanderStyle}">
                            <Expander.Header>
                                <Border Width="25">
                                    <TextBlock FontSize="15" FontWeight="SemiBold" Text="Properties">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </Border>
                            </Expander.Header>
                            <Expander.Content>
                                <Grid>
                                    <!--  Border around both header and property grid  -->
                                    <Border BorderBrush="{DynamicResource PrimaryAccentBrush}" BorderThickness="0" CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!--  Header for selected object  -->
                                            <Border Grid.Row="0"
                                                    Margin="{StaticResource MarginRightSmall}"
                                                    Padding="{StaticResource PaddingSmall}"
                                                    Background="{DynamicResource PrimaryAccentBrush}"
                                                    BorderThickness="0">
                                                <TextBlock Background="{DynamicResource PrimaryAccentBrush}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                           Text="{Binding SelectedObject}"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <pg:CustomPropertyGrid x:Name="PropertyGrid"
                                                                   Grid.Row="1"
                                                                   Margin="{StaticResource MarginRightSmall}"
                                                                   Background="{DynamicResource PropertyGridBackgroundBrush}"
                                                                   EnableVirtualization="True"
                                                                   NameColumnWidth="150"
                                                                   SelectedObject="{Binding SelectedObject, Mode=OneWay}"
                                                                   ShowSearchBox="True" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Expander.Content>
                        </Expander>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>

        <StatusBar Grid.Row="2" Margin="{StaticResource MarginTopSmall}">
            <StatusBarItem>
                <TextBlock x:Name="StatusBarText" Margin="{StaticResource MarginHorizontalSmall}" Text="{Binding CurrentApplicationState.Message}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Margin="{StaticResource MarginRightSmall}" Orientation="Horizontal">
                    <!-- <TextBlock Text="{Binding ComputerName}" Margin="0,0,8,0" VerticalAlignment="Center" /> -->
                    <main:StatusIndicator DataContext="{Binding}" ToolTip="{Binding CurrentApplicationState.Message}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
