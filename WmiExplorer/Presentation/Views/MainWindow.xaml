<Window x:Class="WmiExplorer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WmiExplorer.Presentation.Views.UserControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WmiExplorer"
        xmlns:main="clr-namespace:WmiExplorer.Presentation.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pg="clr-namespace:WmiExplorer.PropertyGrid;assembly=WmiExplorer.PropertyGrid"
        xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
        Title="WmiExplorer"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <!--  Window resources removed - using global converters from App.xaml  -->
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <!--  Menu  -->
            <RowDefinition Height="Auto" />
            <!--  Application Content  -->
            <RowDefinition Height="*" />
            <!--  Status Bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="_File">
                <MenuItem Header="Load..." />
                <MenuItem Header="Save..." />
                <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cut" />
                <MenuItem Header="Copy" />
                <MenuItem Header="Paste" />
            </MenuItem>
            <TextBlock>
                <Hyperlink>
                    <Run Text="{x:Static local:VersionInfo.AppVersion}" />
                </Hyperlink>
            </TextBlock>
            <MenuItem x:Name="ThemeToggle"
                      Margin="{StaticResource MarginHorizontalLarge}"
                      HorizontalAlignment="Right"
                      Command="{Binding ToggleThemeCommand}"
                      DockPanel.Dock="Right"
                      Header="{Binding ThemeToggleText, Mode=OneWay}" />
        </Menu>

        <Grid Name="ApplicationContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" VerticalAlignment="Top">
                <main:OptionsPanel DataContext="{Binding OptionsViewModel}" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="{StaticResource MarginHorizontalSmall}">
                <Grid Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WindowPosition.NamespaceColumnGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.ContentColumnStarGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.PropertyGridColumnStarGridLength, Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <!--  Namespace View  -->
                    <main:WmiNamespacesPane Grid.Column="0" DataContext="{Binding NamespacePaneViewModel}" />

                    <GridSplitter Grid.Column="1"
                                  Width="{StaticResource SpacingMedium}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding WindowPosition.IsNamespacesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  TabControl  -->
                    <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                        <TabItem Header="Classes">
                            <!--  All the grid content has been moved to WmiClassesTab  -->
                            <tabs:WmiClassesTab DataContext="{Binding NamespacePaneViewModel.ClassesTabViewModel}" />
                        </TabItem>
                        <TabItem Header="Search">
                            <!--  Search View  -->
                            <tabs:WmiSearchTab DataContext="{Binding NamespacePaneViewModel.SelectedNamespace.SearchViewModel}" />
                        </TabItem>
                        <TabItem Header="Watcher">
                            <!--  Event Watcher View  -->
                            <tabs:WmiWatcherTab DataContext="{Binding NamespacePaneViewModel.WatcherViewModel}" />
                        </TabItem>
                        <TabItem Header="Query">
                            <!--  Query View  -->
                            <tabs:WmiQueryTab DataContext="{Binding NamespacePaneViewModel.SelectedNamespace.QueryViewModel}" />
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Column="3"
                                  Width="{StaticResource SpacingMedium}"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Visibility="{Binding WindowPosition.IsPropertyGridExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Property Grid View  -->
                    <main:PropertyGridView Grid.Column="4" DataContext="{Binding PropertyGridViewModel}" />
                </Grid>
            </DockPanel>
        </Grid>

        <!--  Status Bar  -->
        <StatusBar Grid.Row="2" Margin="{StaticResource MarginTopSmall}">
            <StatusBarItem>
                <controls:EnhancedStatusIndicator Margin="4,0" DataContext="{Binding}" ToolTip="{Binding CurrentApplicationState.Message}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Margin="4,0" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="{Binding ElapsedTimeMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
