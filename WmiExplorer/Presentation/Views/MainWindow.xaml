<Window x:Class="WmiExplorer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WmiExplorer.Presentation.Controls.UserControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:helpers="clr-namespace:WmiExplorer.Presentation.ViewModels.Helpers"
        xmlns:local="clr-namespace:WmiExplorer"
        xmlns:main="clr-namespace:WmiExplorer.Presentation.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
        Title="WmiExplorer"
        d:Height="800"
        d:Width="1200"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <!--  Debug Mode KeyBinding  -->
    <Window.InputBindings>
        <KeyBinding Key="Q" Command="{Binding ExitCommand}" Modifiers="Control" />
        <KeyBinding Key="D" Command="{Binding ToggleDebugModeCommand}" Modifiers="Control" />
    </Window.InputBindings>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <!--  Menu  -->
            <RowDefinition Height="Auto" />
            <!--  Notification Bar  -->
            <RowDefinition Height="Auto" />
            <!--  Options  -->
            <RowDefinition Height="Auto" />
            <!--  Application Content  -->
            <RowDefinition Height="*" />
            <!--  Status Bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>

            <MenuItem Header="_File">
                <MenuItem Command="{Binding ExitCommand}"
                          Header="E_xit"
                          InputGestureText="Ctrl+Q"
                          ToolTip="Exit the application">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource ExitIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Options">
                <MenuItem Header="Enable ConfigMgr Mode"
                          IsCheckable="True"
                          IsChecked="{Binding SettingsManager.ConfigMgrSettings.ConfigMgrModeEnabled, Mode=TwoWay}"
                          ToolTip="Enable or disable Configuration Manager Mode.">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource ConfigMgrModeIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Check for Updates on Startup"
                          IsCheckable="True"
                          IsChecked="{Binding SettingsManager.AutoUpdateSettings.CheckOnStartup, Mode=TwoWay}"
                          ToolTip="Enable or disable automatic update checks on application startup.">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource CheckUpdateStartupIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_Help">
                <MenuItem Command="{Binding ResetThemeCommand}" Header="Reset Theme..." ToolTip="Resets default theme colors in themes.json file but preserves accent colors. Use this if the themes.json is corrupted or outdated.">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource ColorOffIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>

            <MenuItem Header="_About">
                <MenuItem Header="About WmiExplorer" ToolTip="Show information about WmiExplorer">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource InfoIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Command="{Binding UpdateManager.CheckForUpdatesCommand}" Header="Check for Updates..." ToolTip="Check for the latest version on GitHub.">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource CheckUpdateIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>


            <MenuItem helpers:MenuItemHelper.IsHyperlinkMenuItem="True"
                      Command="{Binding UpdateManager.OpenReleaseUrlCommand}"
                      Header="{Binding VersionText}"
                      ToolTip="Open release page in browser">
                <MenuItem.HeaderTemplate>
                    <DataTemplate>
                        <TextBlock Cursor="Hand"
                                   Foreground="{DynamicResource SecondaryAccentBrush}"
                                   Text="{Binding}"
                                   TextDecorations="Underline" />
                    </DataTemplate>
                </MenuItem.HeaderTemplate>
            </MenuItem>

            <!--  Toggle Theme  -->
            <MenuItem x:Name="ThemeToggle"
                      HorizontalAlignment="Right"
                      Command="{Binding ToggleThemeCommand}"
                      DockPanel.Dock="Right"
                      Header="{Binding CurrentThemeName, Mode=OneWay}"
                      ToolTip="Toggle between Dark and Light theme">
                <MenuItem.Icon>
                    <ContentControl>
                        <ContentControl.Style>
                            <Style TargetType="ContentControl">
                                <Setter Property="ContentTemplate" Value="{StaticResource BrightnessIconTemplate}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentThemeName}" Value="Dark">
                                        <Setter Property="ContentTemplate" Value="{StaticResource QuietHoursIconTemplate}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentThemeName}" Value="Light">
                                        <Setter Property="ContentTemplate" Value="{StaticResource BrightnessIconTemplate}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ContentControl.Style>
                    </ContentControl>
                </MenuItem.Icon>
            </MenuItem>
        </Menu>

        <!--  Update Notification Bar (now in its own row)  -->
        <Border Grid.Row="1"
                Margin="4,0"
                Padding="16,8"
                Background="{DynamicResource PrimaryAccentBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,0"
                CornerRadius="3"
                Visibility="{Binding UpdateManager.IsUpdateNotificationVisible, Converter={StaticResource BoolToVisibilityConverter}}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding UpdateManager.UpdateNotificationMessage}" />
                <Button Margin="16,0,0,0"
                        Command="{Binding UpdateManager.ShowChangelogCommand}"
                        Style="{StaticResource FlatNotificationButton}"
                        Visibility="{Binding UpdateManager.ShowUpdateDownloadButton, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE8BC;" />
                        <TextBlock Margin="4,0,0,0" Text="Changelog" />
                    </StackPanel>
                </Button>
                <Button Margin="16,0,0,0"
                        Command="{Binding UpdateManager.DownloadUpdateCommand}"
                        Style="{StaticResource FlatNotificationButton}"
                        Visibility="{Binding UpdateManager.ShowUpdateDownloadButton, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE78C;" />
                        <TextBlock Margin="4,0,0,0" Text="Download" />
                    </StackPanel>
                </Button>
                <Button Margin="16,0,0,0"
                        Command="{Binding UpdateManager.RelaunchAndInstallUpdateCommand}"
                        Style="{StaticResource FlatNotificationButton}"
                        Visibility="{Binding UpdateManager.ShowRelaunchButton, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xE8AB;" />
                        <TextBlock Margin="4,0,0,0" Text="Relaunch" />
                    </StackPanel>
                </Button>
                <Button Margin="16,0,0,0" Command="{Binding UpdateManager.DismissUpdateNotificationCommand}" Style="{StaticResource FlatNotificationButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconTextBlockStyle}" Text="&#xEA39;" />
                        <TextBlock Margin="4,0,0,0" Text="{Binding UpdateManager.DismissButtonText}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                BorderBrush="{DynamicResource SecondaryBackgroundBrush}"
                BorderThickness="0,0,0,4"
                CornerRadius="0">
            <main:OptionsView x:Name="OptionsViewControl" DataContext="{Binding OptionsViewModel}" />
        </Border>

        <Grid Name="ContentGrid" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding SettingsManager.MainWindowPosition.NamespaceColumnGridLength, Mode=TwoWay}" />
                <ColumnDefinition Width="Auto" />
                <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                <ColumnDefinition Width="{Binding SettingsManager.MainWindowPosition.ContentColumnStarGridLength, Mode=TwoWay}" />
                <ColumnDefinition Width="Auto" />
                <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                <ColumnDefinition Width="{Binding SettingsManager.MainWindowPosition.PropertyGridColumnStarGridLength, Mode=TwoWay}" />
            </Grid.ColumnDefinitions>

            <!--  Namespace View  -->
            <main:NamespacesView Grid.Column="0" DataContext="{Binding NamespacesViewModel}" />
            <GridSplitter Grid.Column="1" Visibility="{Binding SettingsManager.MainWindowPosition.IsNamespacesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!--  Classes Tab  -->
            <Border Grid.Column="2"
                    Margin="4,0,0,0"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0"
                    CornerRadius="3">
                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                    <TabItem Header="{Binding ClassesTabHeader}" TabIndex="0">
                        <tabs:ClassesTabView DataContext="{Binding NamespacesViewModel.ClassesTabViewModel}" />
                    </TabItem>
                    <TabItem Header="{Binding SearchTabHeader}" TabIndex="1">
                        <!--  Search View  -->
                        <tabs:SearchTabView DataContext="{Binding SelectionManager.SelectedNamespace.SearchTabViewModel}" />
                    </TabItem>
                    <TabItem Header="{Binding QueryTabHeader}" TabIndex="2">
                        <!--  Query View  -->
                        <tabs:QueryTabView DataContext="{Binding SelectionManager.SelectedNamespace.QueryTabViewModel}" />
                    </TabItem>
                    <TabItem Header="{Binding WatcherTabHeader}" TabIndex="3">
                        <!--  Event Watcher View  -->
                        <tabs:WatcherTabView DataContext="{Binding NamespacesViewModel.WatcherTabViewModel}" />
                    </TabItem>
                    <TabItem Header="{Binding LogTabHeader}" TabIndex="4">
                        <!--  Log View  -->
                        <tabs:LogTabView DataContext="{Binding LogTabViewModel}" />
                    </TabItem>
                </TabControl>
            </Border>

            <!--  Property Grid View  -->
            <GridSplitter Grid.Column="3" Margin="4,0,0,0" Visibility="{Binding SettingsManager.MainWindowPosition.IsPropertyGridExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

            <main:PropertyGridView Grid.Column="4" DataContext="{Binding}" />

        </Grid>

        <!--  Status Bar  -->
        <StatusBar Grid.Row="4">
            <StatusBarItem>
                <controls:EnhancedStatusIndicator AppState="{Binding CurrentApplicationState.State}"
                                                  Exception="{Binding CurrentApplicationState.Exception}"
                                                  Message="{Binding CurrentApplicationState.Message}"
                                                  ToolTip="{Binding CurrentApplicationState.Message}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Foreground="{DynamicResource PrimaryForegroundBrush}" Text="{Binding ElapsedTimeMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
