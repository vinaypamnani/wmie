<Window x:Class="WmiExplorer.Presentation.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WmiExplorer.Presentation.Controls.UserControls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WmiExplorer"
        xmlns:main="clr-namespace:WmiExplorer.Presentation.Views.Main"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tabs="clr-namespace:WmiExplorer.Presentation.Views.Tabs"
        Title="WmiExplorer"
        d:Height="800"
        d:Width="1200"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        BorderBrush="{DynamicResource BorderBrush}"
        Foreground="{DynamicResource PrimaryForegroundBrush}"
        Icon="/Resources/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d">
    <!--  Window resources removed - using global converters from App.xaml  -->
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <!--  Menu  -->
            <RowDefinition Height="Auto" />
            <!--  Application Content  -->
            <RowDefinition Height="*" />
            <!--  Status Bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="_File">
                <MenuItem Header="Load..." />
                <MenuItem Header="Save..." />
                <MenuItem Command="{Binding ExitCommand}" Header="E_xit">
                    <MenuItem.Icon>
                        <ContentControl ContentTemplate="{StaticResource ExitIconTemplate}" />
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <TextBlock>
                <Hyperlink>
                    <Run Text="{x:Static local:VersionInfo.AppVersion}" />
                </Hyperlink>
            </TextBlock>
            <MenuItem x:Name="ThemeToggle"
                      Margin="{StaticResource MarginHorizontalLarge}"
                      HorizontalAlignment="Right"
                      Command="{Binding ToggleThemeCommand}"
                      DockPanel.Dock="Right"
                      Header="{Binding ThemeToggleText, Mode=OneWay}" />
        </Menu>

        <Grid Name="ApplicationContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" VerticalAlignment="Top">
                <main:OptionsView DataContext="{Binding OptionsViewModel}" />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="{StaticResource MarginHorizontalSmall}">
                <Grid Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WindowPosition.NamespaceColumnGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.ContentColumnStarGridLength, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />
                        <!--  GridSplitter - Giving it fixed width makes it easier to grab  -->
                        <ColumnDefinition Width="{Binding WindowPosition.PropertyGridColumnStarGridLength, Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <!--  Namespace View  -->
                    <main:NamespacesView Grid.Column="0" DataContext="{Binding NamespacesViewModel}" />

                    <GridSplitter Grid.Column="1" Visibility="{Binding WindowPosition.IsNamespacesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TabControl Grid.Column="2" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
                        <TabItem Header="{Binding ClassesTabHeader}">
                            <tabs:ClassesTabView DataContext="{Binding NamespacesViewModel.ClassesTabViewModel}" />
                        </TabItem>
                        <TabItem Header="{Binding SearchTabHeader}">
                            <!--  Search View  -->
                            <tabs:SearchTabView DataContext="{Binding SelectionManager.SelectedNamespace.SearchTabViewModel}" />
                        </TabItem>
                        <TabItem Header="{Binding QueryTabHeader}">
                            <!--  Query View  -->
                            <tabs:QueryTabView DataContext="{Binding SelectionManager.SelectedNamespace.QueryTabViewModel}" />
                        </TabItem>
                        <TabItem Header="{Binding WatcherTabHeader}">
                            <!--  Event Watcher View  -->
                            <tabs:WatcherTabView DataContext="{Binding NamespacesViewModel.WatcherTabViewModel}" />
                        </TabItem>
                        <TabItem Header="{Binding LogTabHeader}">
                            <!--  Log View  -->
                            <tabs:LogTabView DataContext="{Binding LogTabViewModel}" />
                        </TabItem>
                    </TabControl>

                    <GridSplitter Grid.Column="3" Visibility="{Binding WindowPosition.IsPropertyGridExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!--  Property Grid View  -->
                    <main:PropertyGridView Grid.Column="4" DataContext="{Binding}" />
                </Grid>
            </DockPanel>
        </Grid>

        <!--  Status Bar  -->
        <StatusBar Grid.Row="2" Margin="{StaticResource MarginTopSmall}">
            <StatusBarItem>
                <controls:EnhancedStatusIndicator Margin="4,0"
                                                  AppState="{Binding CurrentApplicationState.State}"
                                                  Message="{Binding CurrentApplicationState.Message}"
                                                  ToolTip="{Binding CurrentApplicationState.Message}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Margin="4,0" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="{Binding ElapsedTimeMessage}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
