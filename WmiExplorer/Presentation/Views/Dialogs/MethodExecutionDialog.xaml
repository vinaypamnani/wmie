<!--  filepath: c:\repos\wmie\WmiExplorer\Presentation\Views\Dialogs\MethodExecutionDialog.xaml  -->
<Window x:Class="WmiExplorer.Presentation.Views.Dialogs.MethodExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Dialogs"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Execute WMI Method"
        Width="600"
        Height="450"
        WindowStartupLocation="CenterOwner"
        mc:Ignorable="d">

    <Window.Resources>
        <Style x:Key="HeaderTextBlockStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,10,0,5" />
        </Style>

        <Style x:Key="LabelTextBlockStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Width" Value="120" />
        </Style>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Method Information  -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="Method Information" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Style="{StaticResource LabelTextBlockStyle}"
                           Text="Class:" />
                <TextBlock Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding ClassName}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Style="{StaticResource LabelTextBlockStyle}"
                           Text="Instance:" />
                <TextBlock Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding InstanceName}"
                           TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStaticMethod}" Value="True">
                                    <Setter Property="Text" Value="N/A (Static Method)" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding InstanceName}" Value="">
                                    <Setter Property="Text" Value="N/A (Static Method)" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock Grid.Row="2"
                           Grid.Column="0"
                           Style="{StaticResource LabelTextBlockStyle}"
                           Text="Method:" />
                <TextBlock Grid.Row="2"
                           Grid.Column="1"
                           FontWeight="Bold"
                           Text="{Binding MethodName}"
                           TextTrimming="CharacterEllipsis" />

                <TextBlock Grid.Row="3"
                           Grid.Column="0"
                           VerticalAlignment="Top"
                           Style="{StaticResource LabelTextBlockStyle}"
                           Text="Description:" />
                <TextBlock Grid.Row="3"
                           Grid.Column="1"
                           Text="{Binding MethodDescription}"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style BasedOn="{StaticResource {x:Type TextBlock}}" TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MethodDescription}" Value="">
                                    <Setter Property="Text" Value="No description available" />
                                    <Setter Property="Foreground" Value="Gray" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>

        <!--  Parameters Header  -->
        <TextBlock Grid.Row="1" Style="{StaticResource HeaderTextBlockStyle}" Text="Parameters" />

        <!--  Parameters List  -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Parameters}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock Margin="0,0,5,0" Text=":" />
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Grid.Column="0"
                                       FontSize="11"
                                       Foreground="Gray"
                                       Text="{Binding Type}" />

                            <TextBox Grid.RowSpan="2"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>

                <!--  No Parameters Message  -->
                <ItemsControl.Style>
                    <Style TargetType="ItemsControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Parameters.Count}" Value="0">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate>
                                            <TextBlock HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="Gray"
                                                       Text="This method has no input parameters" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ItemsControl.Style>
            </ItemsControl>
        </ScrollViewer>

        <!--  Execute Button  -->
        <Button Grid.Row="3"
                Margin="0,10"
                Padding="15,5"
                HorizontalAlignment="Right"
                Command="{Binding ExecuteMethodCommand}"
                Content="Execute Method" />

        <!--  Results  -->
        <GroupBox Grid.Row="4" Header="Results">
            <TextBox FontFamily="Consolas"
                     IsReadOnly="True"
                     Text="{Binding ExecutionResults, Mode=OneWay}"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" />
        </GroupBox>
    </Grid>
</Window>
