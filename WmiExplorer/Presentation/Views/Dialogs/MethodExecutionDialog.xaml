<Window x:Class="WmiExplorer.Presentation.Views.Dialogs.MethodExecutionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Dialogs"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pg="clr-namespace:WmiExplorer.PropertyGrid;assembly=WmiExplorer.PropertyGrid"
        Width="600"
        Height="600"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        mc:Ignorable="d">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header Area - Draggable  -->
            <Border Grid.Row="0"
                    Padding="16,8,16,8"
                    behaviors:WindowDragBehavior.IsDragEnabled="True"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,0">
                <!--  Header content with subtle accent strip  -->
                <StackPanel Orientation="Vertical">

                    <!--  Method Name with accent underline  -->
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Text="{Binding MethodName}" />

                    <!--  Class and Instance Info  -->
                    <Grid Margin="0,0,0,2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Class Info  -->
                        <TextBlock Grid.Row="0"
                                   Grid.Column="0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="Class: " />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Text="{Binding ClassName}" />

                        <!--  Instance Info  -->
                        <TextBlock Grid.Row="1"
                                   Grid.Column="0"
                                   FontSize="13"
                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                   Text="Instance: "
                                   Visibility="{Binding InstanceName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Text="{Binding InstanceName}"
                                   Visibility="{Binding InstanceName, Converter={StaticResource StringNotEmptyToVisibilityConverter}}" />
                    </Grid>

                    <!--  Accent underline  -->
                    <Rectangle Height="2"
                               Margin="0,2,0,2"
                               HorizontalAlignment="Stretch"
                               Fill="{DynamicResource PrimaryAccentBrush}" />
                </StackPanel>
            </Border>

            <!--  Method Description Area  -->
            <Border Grid.Row="1"
                    Padding="16,0,16,0"
                    BorderThickness="0,0,0,0"
                    Visibility="{Binding MethodDescription, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                <Grid>
                    <!--  Collapsed/Truncated Description  -->
                    <Grid Visibility="{Binding IsMethodDescriptionExpanded, Converter={StaticResource InverseBooleanConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryAccentBrush}"
                                   Text="More">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding ExpandMethodDescriptionCommand}" MouseAction="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   MaxHeight="19"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Text="{Binding MethodDescription}"
                                   TextTrimming="CharacterEllipsis"
                                   TextWrapping="NoWrap"
                                   ToolTip="{Binding MethodDescription}" />
                    </Grid>

                    <!--  Expanded Description  -->
                    <Grid Visibility="{Binding IsMethodDescriptionExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Top"
                                   Cursor="Hand"
                                   FontSize="12"
                                   Foreground="{DynamicResource PrimaryAccentBrush}"
                                   Text="Less">
                            <TextBlock.InputBindings>
                                <MouseBinding Command="{Binding CollapseMethodDescriptionCommand}" MouseAction="LeftClick" />
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Grid.Column="1"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{DynamicResource PrimaryForegroundBrush}"
                                   Text="{Binding MethodDescription}"
                                   TextWrapping="Wrap"
                                   ToolTip="{Binding MethodDescription}" />
                    </Grid>
                </Grid>
            </Border>
            <!--  Main Content  -->
            <TabControl Grid.Row="2"
                        Margin="16,8,16,0"
                        Padding="8,0,8,0"
                        BorderThickness="1"
                        SelectedIndex="{Binding SelectedTabIndex}">
                <!--  Input Parameters Tab  -->
                <TabItem Header="Input">
                    <ScrollViewer Margin="0,10,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Parameters}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,5"
                                            Padding="8"
                                            Background="{DynamicResource SecondaryBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!--  Top Row with Checkbox and ID  -->
                                            <DockPanel Grid.Row="0">
                                                <CheckBox Margin="0,4,8,0"
                                                          VerticalAlignment="Top"
                                                          DockPanel.Dock="Left"
                                                          IsChecked="{Binding IsSelected}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                        <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" Text=" [" />
                                                        <TextBlock FontStyle="Italic" Foreground="{DynamicResource SecondaryForegroundBrush}" Text="{Binding Type}" />
                                                        <TextBlock Foreground="{DynamicResource SecondaryForegroundBrush}" Text="]" />
                                                    </StackPanel>
                                                </CheckBox>
                                                <TextBlock HorizontalAlignment="Right"
                                                           DockPanel.Dock="Right"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                           Text="{Binding Id, StringFormat=ID: {0}}" />
                                            </DockPanel>

                                            <!--  Parameter Content Below Checkbox  -->
                                            <StackPanel Grid.Row="1" Margin="20,5,0,0">

                                                <!--  Parameter Description  -->
                                                <Grid Visibility="{Binding Description, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                                                    <!--  Collapsed/Truncated Description  -->
                                                    <Grid Visibility="{Binding IsDescriptionExpanded, Converter={StaticResource InverseBooleanConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Top"
                                                                   Cursor="Hand"
                                                                   Foreground="{DynamicResource PrimaryAccentBrush}"
                                                                   Text="More">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding Command="{Binding ExpandDescriptionCommand}" MouseAction="LeftClick" />
                                                            </TextBlock.InputBindings>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   MaxHeight="19"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Top"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Text="{Binding Description}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   TextWrapping="NoWrap"
                                                                   ToolTip="{Binding Description}" />
                                                    </Grid>

                                                    <!--  Expanded Description  -->
                                                    <Grid Visibility="{Binding IsDescriptionExpanded, Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="0,0,8,0"
                                                                   VerticalAlignment="Top"
                                                                   Cursor="Hand"
                                                                   Foreground="{DynamicResource PrimaryAccentBrush}"
                                                                   Text="Less">
                                                            <TextBlock.InputBindings>
                                                                <MouseBinding Command="{Binding CollapseDescriptionCommand}" MouseAction="LeftClick" />
                                                            </TextBlock.InputBindings>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   HorizontalAlignment="Stretch"
                                                                   VerticalAlignment="Top"
                                                                   Foreground="{DynamicResource SecondaryForegroundBrush}"
                                                                   Text="{Binding Description}"
                                                                   TextWrapping="Wrap"
                                                                   ToolTip="{Binding Description}" />
                                                    </Grid>
                                                </Grid>

                                                <!--  Value Input  -->
                                                <TextBox HorizontalAlignment="Stretch" IsEnabled="{Binding IsEnabled}" Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                                                    <TextBox.Style>
                                                        <Style BasedOn="{StaticResource TextBoxWithPlaceholder}" TargetType="{x:Type TextBox}">
                                                            <Setter Property="Tag" Value="Enter value..." />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsComplexType}" Value="True">
                                                                    <Setter Property="Background" Value="{StaticResource DisabledBackgroundBrush}" />
                                                                    <Setter Property="ToolTip" Value="Complex type parameters are not currently supported" />
                                                                    <Setter Property="Tag" Value="Complex type (not supported)" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                                                    <Setter Property="IsEnabled" Value="False" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <!--  No Parameters Message  -->
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Parameters.Count}" Value="0">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate>
                                                        <TextBlock HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="Gray"
                                                                   Text="This method has no input parameters" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>

                <!--  Output Parameters Tab  -->
                <TabItem Header="Output">
                    <Grid Margin="0,10,0,0">
                        <pg:PropertyGrid x:Name="OutputPropertyGrid"
                                         Margin="0"
                                         EnableVirtualization="True"
                                         NameColumnWidth="150"
                                         SelectedObject="{Binding OutputParameters}"
                                         ShowOptions="False"
                                         ShowSearchBox="False" />
                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource DisabledForegroundBrush}"
                                   Text="Output parameters will appear here after execution"
                                   Visibility="{Binding HasOutputParameters, Converter={StaticResource InverseBooleanConverter}}" />
                    </Grid>
                </TabItem>
            </TabControl>
            <!--  Button Panel and Status Bar  -->
            <DockPanel Grid.Row="3">
                <!--  Status Bar  -->
                <Border BorderThickness="0,1,0,0" DockPanel.Dock="Bottom">
                    <TextBlock Padding="10,3"
                               Background="{DynamicResource SecondaryBackgroundBrush}"
                               FontSize="12"
                               Text="{Binding StatusMessage}" />
                </Border>

                <!--  Button Panel  -->
                <StackPanel Margin="15,10"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                    <Button Width="80"
                            Height="24"
                            Margin="0,0,5,0"
                            Command="{Binding ExecuteMethodCommand}"
                            Content="Execute" />
                    <Button Width="80"
                            Height="24"
                            Command="{Binding CancelCommand}"
                            Content="Close" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
