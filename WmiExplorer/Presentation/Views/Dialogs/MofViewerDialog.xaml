<Window x:Class="WmiExplorer.Presentation.Views.Dialogs.MofViewerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels.Dialogs"
        Title="MOF Viewer"
        Width="800"
        Height="450"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        mc:Ignorable="d">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header Area  -->
            <Border Grid.Row="0"
                    Margin="8,0,8,0"
                    Padding="8"
                    behaviors:WindowDragBehavior.IsDragEnabled="True"
                    Background="{DynamicResource PrimaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Text="Managed Object Format (MOF)" />
                    <Rectangle Height="2"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Stretch"
                               Fill="{DynamicResource PrimaryAccentBrush}" />
                </StackPanel>
            </Border>

            <!--  Content Area  -->
            <ScrollViewer Grid.Row="1" Margin="8" VerticalScrollBarVisibility="Auto">
                <TextBox Margin="0,0,0,10"
                         Background="{DynamicResource SecondaryBackgroundBrush}"
                         BorderThickness="0"
                         FontFamily="Consolas"
                         FontSize="14"
                         Foreground="{DynamicResource PrimaryForegroundBrush}"
                         HorizontalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         Text="{Binding MofContent, Mode=OneWay}"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" />
            </ScrollViewer>

            <!--  Button Area  -->
            <Border Grid.Row="2"
                    Margin="8,0,8,0"
                    Padding="8"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,1,0,0">
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button Width="80"
                            Margin="0,0,10,0"
                            Command="{Binding CopyCommand}"
                            Content="Copy" />
                    <Button Width="80" Click="CloseButton_Click" Content="Close" />
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
