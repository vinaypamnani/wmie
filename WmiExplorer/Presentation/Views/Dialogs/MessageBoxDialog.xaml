<Window x:Class="WmiExplorer.Presentation.Views.Dialogs.MessageBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
        xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Dialogs"
        Title="{Binding Title}"
        MinWidth="320"
        MinHeight="160"
        AllowsTransparency="True"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <!--  InputBindings for keyboard shortcuts  -->
    <Window.InputBindings>
        <KeyBinding Key="C" Command="{Binding CopyCommand}" Modifiers="Control" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="3">
        <DockPanel LastChildFill="True">
            <!--  Custom Title Bar  -->
            <Border Padding="8"
                    behaviors:WindowDragBehavior.IsDragEnabled="True"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    DockPanel.Dock="Top">
                <StackPanel Orientation="Vertical">
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryForegroundBrush}"
                               Text="{Binding Title}" />
                    <Rectangle Height="2"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Stretch"
                               Fill="{DynamicResource PrimaryAccentBrush}" />
                </StackPanel>
            </Border>
            <!--  Main Content  -->
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Icon  -->
                <ContentControl Grid.Row="0"
                                Grid.Column="0"
                                Width="40"
                                Height="40"
                                VerticalAlignment="Top">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{x:Null}" />
                            <Setter Property="Content" Value="" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="Information">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxInfoIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Warning">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxWarningIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Error">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxErrorIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Question">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxQuestionIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!--  Message  -->
                <ScrollViewer Grid.Row="0"
                              Grid.Column="2"
                              MinWidth="100"
                              MinHeight="40"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        FontSize="14"
                        Text="{Binding Message}"
                        TextWrapping="Wrap"
                        MaxWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollViewer}}"
                    />
                </ScrollViewer>

                <!--  Buttons  -->
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Grid.ColumnSpan="3"
                      Margin="0,24,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <!--  Copy Button Left-Aligned  -->
                    <Button Grid.Column="0"
                            MinWidth="75"
                            Margin="0,0,8,0"
                            HorizontalAlignment="Left"
                            Command="{Binding CopyCommand}"
                            Content="Copy"
                            Visibility="{Binding CopyVisibility}" />
                    <!--  Other Buttons Right-Aligned  -->
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button MinWidth="75"
                                Margin="8,0,0,0"
                                Command="{Binding OkCommand}"
                                Content="OK"
                                Visibility="{Binding OkVisibility}" />
                        <Button MinWidth="75"
                                Margin="8,0,0,0"
                                Command="{Binding CancelCommand}"
                                Content="Cancel"
                                Visibility="{Binding CancelVisibility}" />
                        <Button MinWidth="75"
                                Margin="8,0,0,0"
                                Command="{Binding YesCommand}"
                                Content="Yes"
                                Visibility="{Binding YesVisibility}" />
                        <Button MinWidth="75"
                                Margin="8,0,0,0"
                                Command="{Binding NoCommand}"
                                Content="No"
                                Visibility="{Binding NoVisibility}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
