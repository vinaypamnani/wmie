<Window x:Class="WmiExplorer.Presentation.Views.Dialogs.MessageBoxDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
        xmlns:local="clr-namespace:WmiExplorer.Presentation.Views.Dialogs"
        Title="{Binding Title}"
        Width="400"
        Height="200"
        Background="{DynamicResource PrimaryBackgroundBrush}"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <DockPanel LastChildFill="True">
            <!--  Custom Title Bar  -->
            <Border Padding="16,8,16,8"
                    behaviors:WindowDragBehavior.IsDragEnabled="True"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    CornerRadius="8,8,0,0"
                    DockPanel.Dock="Top">
                <TextBlock FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryForegroundBrush}"
                           Text="{Binding Title}" />
            </Border>
            <!--  Main Content  -->
            <Grid Margin="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Icon  -->
                <ContentControl Grid.Row="0"
                                Grid.Column="0"
                                Width="40"
                                Height="40">
                    <ContentControl.Style>
                        <Style TargetType="ContentControl">
                            <Setter Property="ContentTemplate" Value="{x:Null}" />
                            <Setter Property="Content" Value="" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Icon}" Value="Information">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxInfoIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Warning">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxWarningIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Error">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxErrorIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="Question">
                                    <Setter Property="ContentTemplate" Value="{StaticResource MessageBoxQuestionIconTemplate}" />
                                    <Setter Property="Content" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Icon}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ContentControl.Style>
                </ContentControl>

                <!--  Message  -->
                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="{Binding Message}"
                           TextWrapping="Wrap" />

                <!--  Buttons  -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Margin="0,24,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <!--  OK Button  -->
                    <Button MinWidth="75"
                            Margin="8,0,0,0"
                            Command="{Binding OkCommand}"
                            Content="OK"
                            Visibility="{Binding OkVisibility}" />
                    <!--  Cancel Button  -->
                    <Button MinWidth="75"
                            Margin="8,0,0,0"
                            Command="{Binding CancelCommand}"
                            Content="Cancel"
                            Visibility="{Binding CancelVisibility}" />
                    <!--  Yes Button  -->
                    <Button MinWidth="75"
                            Margin="8,0,0,0"
                            Command="{Binding YesCommand}"
                            Content="Yes"
                            Visibility="{Binding YesVisibility}" />
                    <!--  No Button  -->
                    <Button MinWidth="75"
                            Margin="8,0,0,0"
                            Command="{Binding NoCommand}"
                            Content="No"
                            Visibility="{Binding NoVisibility}" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</Window>
