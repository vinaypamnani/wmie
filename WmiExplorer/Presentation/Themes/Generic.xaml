<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--  Fallback theme: Matches Light theme colors from ThemeService.cs  -->
    <!--  Colors  -->
    <Color x:Key="PrimaryBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFF5F5F5</Color>
    <Color x:Key="TertiaryBackgroundColor">#FFEBEBEB</Color>
    <Color x:Key="DisabledBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="PrimaryForegroundColor">#FF202020</Color>
    <Color x:Key="SecondaryForegroundColor">#FF505050</Color>
    <Color x:Key="TertiaryForegroundColor">#FF8A8A8A</Color>
    <Color x:Key="DisabledForegroundColor">#FFB0B0B0</Color>
    <Color x:Key="PrimaryAccentColor">#FF0078D7</Color>
    <Color x:Key="SecondaryAccentColor">#FF3A96DD</Color>
    <Color x:Key="BorderColor">#FFD0D0D0</Color>
    <Color x:Key="BaseGreen">#FF0F7B0F</Color>
    <Color x:Key="BaseRed">#FFE81123</Color>
    <Color x:Key="BaseOrange">#FFFF8C00</Color>
    <Color x:Key="BaseTan">#FFA0522D</Color>
    <Color x:Key="BaseGray">#FF767676</Color>
    <Color x:Key="BaseBlue">#FF0063B1</Color>

    <!--  Base color brushes  -->
    <SolidColorBrush x:Key="BaseGreenBrush" Color="{StaticResource BaseGreen}" />
    <SolidColorBrush x:Key="BaseRedBrush" Color="{StaticResource BaseRed}" />
    <SolidColorBrush x:Key="BaseOrangeBrush" Color="{StaticResource BaseOrange}" />
    <SolidColorBrush x:Key="BaseTanBrush" Color="{StaticResource BaseTan}" />
    <SolidColorBrush x:Key="BaseGrayBrush" Color="{StaticResource BaseGray}" />
    <SolidColorBrush x:Key="BaseBlueBrush" Color="{StaticResource BaseBlue}" />

    <!--  Base Brushes  -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="TertiaryForegroundBrush" Color="{StaticResource TertiaryForegroundColor}" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!--  Interaction State Brushes  -->
    <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Opacity="0.8" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="SelectedUnfocusedBackgroundBrush" Opacity="0.4" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Opacity="0.6" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="ItemPressedBrush" Opacity="0.75" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="FocusedElementBrush" Opacity="0.75" Color="{StaticResource BaseGreen}" />

    <!--  ScrollBar Brushes  -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Opacity="0.8" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Opacity="0.7" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Opacity="0.9" Color="{StaticResource PrimaryAccentColor}" />

    <!--  PropertyGrid Colors (Consolidated, only used brushes)  -->
    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridSecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridCategoryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridSelectedBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridDisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridHoverBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridKeyHighlightBrush" Color="{StaticResource BaseGreen}" />
    <SolidColorBrush x:Key="PropertyGridFocusedElementBrush" Color="{StaticResource BaseGreen}" />

</ResourceDictionary>
