<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Fallback theme: Light colors and brushes -->
    <!-- Base Colors -->
    <Color x:Key="PrimaryBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFF8F9FA</Color>
    <Color x:Key="TertiaryBackgroundColor">#FFF0F1F3</Color>
    <Color x:Key="PrimaryForegroundColor">#FF202020</Color>
    <Color x:Key="SecondaryForegroundColor">#FF202020</Color>
    <Color x:Key="ReadOnlyForegroundColor">#FFB0B0B0</Color>
    <Color x:Key="PrimaryAccentColor">#FF0078D4</Color>
    <Color x:Key="SecondaryAccentColor">#FF5B87C5</Color>
    <Color x:Key="BorderColor">#FFD8D8D8</Color>
    <Color x:Key="SuccessColor">#FF107C10</Color>
    <Color x:Key="ErrorColor">#FFD13438</Color>
    <Color x:Key="WarningColor">#FFFF8C00</Color>
    <Color x:Key="IndeterminateColor">#FF767676</Color>
    <Color x:Key="BusyColor">#FF0063B1</Color>
    <Color x:Key="NoFocusColor">#FFD0D0D0</Color>

    <!-- Additional fallback keys to match Light theme superset -->
    <Color x:Key="DisabledBackgroundColor">#FFF0F0F0</Color>
    <Color x:Key="DisabledForegroundColor">#FFB0B0B0</Color>
    <Color x:Key="HighlightColor">#FFCCE7FF</Color>
    <Color x:Key="ControlBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="ControlForegroundColor">#FF202020</Color>
    <Color x:Key="WindowBackgroundColor">#FFF8F9FA</Color>
    <Color x:Key="WindowBorderColor">#FFD8D8D8</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="InputForegroundColor">#FF202020</Color>
    <Color x:Key="InputBorderColor">#FFD8D8D8</Color>
    <Color x:Key="FocusVisualColor">#FF0078D4</Color>
    <Color x:Key="SelectionForegroundColor">#FFFFFFFF</Color>
    <Color x:Key="SelectionBorderColor">#FF0078D4</Color>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="IndeterminateBrush" Color="{StaticResource IndeterminateColor}" />
    <SolidColorBrush x:Key="BusyBrush" Color="{StaticResource BusyColor}" />

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Color="{StaticResource PrimaryAccentColor}"/>
    <SolidColorBrush x:Key="SelectedUnfocusedBackgroundBrush" Color="{StaticResource NoFocusColor}" />
    <SolidColorBrush x:Key="ReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="{StaticResource SecondaryAccentColor}" Opacity="0.50" />

    <!-- Additional fallback brushes to match Light theme superset -->
    <SolidColorBrush x:Key="DisabledBackgroundBrush" Color="{StaticResource DisabledBackgroundColor}" />
    <SolidColorBrush x:Key="DisabledForegroundBrush" Color="{StaticResource DisabledForegroundColor}" />
    <SolidColorBrush x:Key="HighlightBrush" Color="{StaticResource HighlightColor}" />
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackgroundColor}" />
    <SolidColorBrush x:Key="ControlForegroundBrush" Color="{StaticResource ControlForegroundColor}" />
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="{StaticResource WindowBorderColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="InputForegroundBrush" Color="{StaticResource InputForegroundColor}" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="FocusVisualBrush" Color="{StaticResource FocusVisualColor}" />
    <SolidColorBrush x:Key="SelectionForegroundBrush" Color="{StaticResource SelectionForegroundColor}" />
    <SolidColorBrush x:Key="SelectionBorderBrush" Color="{StaticResource SelectionBorderColor}" />

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource PrimaryAccentColor}" />

    <!-- PropertyGrid Colors (Consolidated, only used brushes) -->
    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridSecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridCategoryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridSelectedBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridHoverBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />
</ResourceDictionary>
