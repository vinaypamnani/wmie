<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Menu brushes -->
    <SolidColorBrush x:Key="Menu.Static.Background"
            Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="Menu.Static.Border"
            Color="Transparent"/>
    <SolidColorBrush x:Key="MenuItem.Selected.Background"
            Color="#FF007ACC"/>
    <SolidColorBrush x:Key="MenuItem.Selected.Border"
            Color="#FF007ACC"/>
    <!--  Menu  -->
    <Style TargetType="Menu">
        <Setter Property="Foreground"
                Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background"
                Value="{StaticResource Menu.Static.Background}"/>
        <Setter Property="BorderBrush"
                Value="{StaticResource Menu.Static.Border}"/>
        <Setter Property="BorderThickness"
                Value="0"/>
        <Setter Property="Padding"
                Value="3,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Menu}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="true">
                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Custom template for MenuItems that removes the white border around submenus -->
    <ControlTemplate x:Key="MenuItemControlTemplate"
                     TargetType="{x:Type MenuItem}">
        <Border x:Name="templateRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="True">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="IconColumn" Width="0"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Icon content if present -->
                <ContentPresenter x:Name="Icon"
                                  ContentSource="Icon"
                                  HorizontalAlignment="Center"
                                  Height="16"
                                  Margin="0"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  VerticalAlignment="Center"
                                  Width="16"/>
                <!-- Header content -->
                <ContentPresenter Grid.Column="1"
                                  ContentSource="Header"
                                  Margin="{TemplateBinding Padding}"
                                  RecognizesAccessKey="True"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                <!-- Popup for submenu -->
                <Popup x:Name="PART_Popup"
                       AllowsTransparency="True"
                       Focusable="False"
                       Placement="Right"
                       StaysOpen="False"
                       Margin="0"
                       PopupAnimation="None"
                       HorizontalOffset="0"
                       IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                    <Border x:Name="SubMenuBorder"
                            Background="{StaticResource Menu.Static.Background}"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            Padding="2,3"
                            MinWidth="175"
                            SnapsToDevicePixels="True"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect Color="Black"
                                              Direction="315"
                                              BlurRadius="7"
                                              ShadowDepth="3"
                                              Opacity="0.3"/>
                        </Border.Effect>
                        <ScrollViewer x:Name="SubMenuScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      BorderThickness="0"
                                      Padding="0">
                            <ItemsPresenter x:Name="ItemsPresenter"
                                            Grid.IsSharedSizeScope="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle"
                                            Margin="0"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
        </Border>
        <ControlTemplate.Triggers>
            <!-- Highlight on mouse over -->
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource MenuItem.Selected.Background}"/>
                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource MenuItem.Selected.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBackgroundBrush}"/>
            </Trigger>
            <!-- Change appearance when menu item is pressed -->
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" TargetName="templateRoot" Value="{DynamicResource SecondaryAccentBrush}"/>
                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{DynamicResource SecondaryAccentBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBackgroundBrush}"/>
            </Trigger>
            <!-- Change appearance when menu item is enabled/disabled -->
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource BorderBrush}"/>
                <Setter Property="Opacity" TargetName="templateRoot" Value="0.7"/>
            </Trigger>
            <!-- Handle top-level menu items differently (those in the main menu bar) -->
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Placement" TargetName="PART_Popup" Value="Bottom"/>
                <Setter Property="Width" TargetName="IconColumn" Value="0"/>
                <Setter Property="Margin" TargetName="templateRoot" Value="2,0,2,0"/>
            </Trigger>
            <!-- Handle top-level menu items without children -->
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="Width" TargetName="IconColumn" Value="0"/>
                <Setter Property="Margin" TargetName="templateRoot" Value="2,0,2,0"/>
            </Trigger>
            <!-- Handle submenu headers differently -->
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="MinWidth" Value="150"/>
            </Trigger>
            <!-- Make sure top-level menu items look good when selected -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsHighlighted" Value="True"/>
                    <Condition Property="Role" Value="TopLevelHeader"/>
                </MultiTrigger.Conditions>
                <Setter Property="Background" TargetName="templateRoot" Value="{StaticResource MenuItem.Selected.Background}"/>
                <Setter Property="BorderBrush" TargetName="templateRoot" Value="{StaticResource MenuItem.Selected.Border}"/>
                <Setter Property="Foreground" Value="{DynamicResource PrimaryBackgroundBrush}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Style for ContextMenu to remove border -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource Menu.Static.Background}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="2"/>
        <Setter Property="MinWidth" Value="175"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{StaticResource Menu.Static.Background}"
                            BorderThickness="0"
                            BorderBrush="Transparent"
                            Padding="2,3"
                            UseLayoutRounding="True">
                        <Border.Effect>
                            <DropShadowEffect Color="Black"
                                              Direction="315"
                                              BlurRadius="7"
                                              ShadowDepth="3"
                                              Opacity="0.3"/>
                        </Border.Effect>
                        <ItemsPresenter Margin="0"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Style for all MenuItem elements -->
    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="12,6"/>
        <Setter Property="Foreground" Value="{DynamicResource PrimaryForegroundBrush}"/>
        <Setter Property="Background" Value="{StaticResource Menu.Static.Background}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Menu.Static.Border}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template" Value="{StaticResource MenuItemControlTemplate}"/>
        <Setter Property="Margin" Value="0,0,3,0"/>
    </Style>
</ResourceDictionary>
