<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="PrimaryBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFF8F9FA</Color>
    <Color x:Key="PrimaryForegroundColor">#FF202020</Color>
    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="SecondaryAccentColor">#FF5B87C5</Color>
    <Color x:Key="BorderColor">#FFD8D8D8</Color>
    <Color x:Key="NoFocusColor">#FFD0D0D0</Color>
    <Color x:Key="ReadOnlyForegroundColor">#FFB0B0B0</Color>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C10" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF8C00" />
    <SolidColorBrush x:Key="IndeterminateBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="BusyBrush" Color="#FF0063B1" />

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />    
    <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="SelectedUnfocusedBackgroundBrush" Color="{StaticResource NoFocusColor}" />        
    <SolidColorBrush x:Key="ReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource AccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="{StaticResource SecondaryAccentColor}" Opacity="0.50" />

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource AccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource AccentColor}" />

    <!-- PropertyGrid Colors (Consolidated, only used brushes) -->
    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="PropertyGridSelectedBackgroundBrush" Color="{StaticResource AccentColor}" Opacity="0.20" />    
    <SolidColorBrush x:Key="PropertyGridCategoryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridCaretBrush" Color="{StaticResource PrimaryForegroundColor}" />
</ResourceDictionary>