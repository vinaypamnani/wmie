<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="PrimaryBackgroundColor">#FFFFFFFF</Color>
    <Color x:Key="SecondaryBackgroundColor">#FFF8F9FA</Color>
    <Color x:Key="PrimaryForegroundColor">#FF202020</Color>
    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="SecondaryAccentColor">#FF5B87C5</Color>
    <Color x:Key="BorderColor">#FFD8D8D8</Color>
    <Color x:Key="NoFocusColor">#FFD0D0D0</Color>

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />

    <!-- Menu -->
    <SolidColorBrush x:Key="MenuItemForegroundBrush" Color="#202020" />
    <SolidColorBrush x:Key="MenuItemBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="MenuItemBorderBrush" Color="#E0E0E0" />

    <!-- GridSplitter -->
    <SolidColorBrush x:Key="GridSplitterBackground" Color="#E5E5E5" />
    <SolidColorBrush x:Key="GridSplitterHoverBackground" Color="#C0C0C0" />

    <!-- ListView -->
    <SolidColorBrush x:Key="ListViewItemSelectedBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ListViewItemHoverBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ListViewItemHoverBorderBrush" Color="#FF6DB0E6" />
    <SolidColorBrush x:Key="ListViewItemUnfocusedSelectedBackgroundBrush" Color="{StaticResource NoFocusColor}" />
    <SolidColorBrush x:Key="ListViewItemUnfocusedSelectedBorderBrush" Color="{StaticResource NoFocusColor}" />

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#FFB8B8B8" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource SecondaryAccentColor}" />

    <!-- Status Colors -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF107C10" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFD13438" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFF8C00" />
    <SolidColorBrush x:Key="IndeterminateBrush" Color="#FF767676" />
    <SolidColorBrush x:Key="BusyBrush" Color="#FF0063B1" />

    <!-- PropertyGrid Colors -->
    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="PropertyGridCategoryBackgroundBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="PropertyGridCategoryForegroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="#FF0078D7" />
    <SolidColorBrush x:Key="PropertyGridSelectedBackgroundBrush" Color="#FF0078D4" />
    <SolidColorBrush x:Key="PropertyGridSelectedForegroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PropertyGridInputBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PropertyGridInputForegroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="PropertyGridInputBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="PropertyGridSearchBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PropertyGridSearchForegroundBrush" Color="#FF202020" />
    <SolidColorBrush x:Key="PropertyGridSearchBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="PropertyGridSearchPlaceholderBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="PropertyGridSearchFocusBackgroundBrush" Color="#FFF0F5FB" />
    <SolidColorBrush x:Key="PropertyGridCaretBrush" Color="#FF000000" />

    <!-- Additional PropertyGrid resources -->
    <SolidColorBrush x:Key="PropertyGridHeaderBackgroundBrush" Color="#FFF8F8F8" />
    <SolidColorBrush x:Key="PropertyGridHeaderForegroundBrush" Color="#FF323232" />
    <SolidColorBrush x:Key="PropertyGridHeaderBorderBrush" Color="#FFD8D8D8" />
    <SolidColorBrush x:Key="PropertyGridCategoryHeaderBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="PropertyGridCategoryHeaderForegroundBrush" Color="#FF505050" />
    <SolidColorBrush x:Key="PropertyGridCategoryExpanderBrush" Color="#FF505050" />
    <SolidColorBrush x:Key="PropertyGridNameColumnBackgroundBrush" Color="#FFF8F8F8" />
    <SolidColorBrush x:Key="PropertyGridValueColumnBackgroundBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="PropertyGridDescriptionBackgroundBrush" Color="#FFF8F8F8" />
    <SolidColorBrush x:Key="PropertyGridDescriptionForegroundBrush" Color="#FF606060" />
    <SolidColorBrush x:Key="PropertyGridReadOnlyBackgroundBrush" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="PropertyGridReadOnlyForegroundBrush" Color="#FF808080" />

    <!-- Help pane brushes -->
    <SolidColorBrush x:Key="PropertyGridHelpPaneBackgroundBrush" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="PropertyGridHelpPaneTextBrush" Color="#FF323232" />
</ResourceDictionary>