<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Base Colors -->
    <Color x:Key="PrimaryBackgroundColor">#FF181818</Color>
    <Color x:Key="SecondaryBackgroundColor">#FF1F1F1F</Color>
    <Color x:Key="TertiaryBackgroundColor">#FF1F1F1F</Color>
    <Color x:Key="PrimaryForegroundColor">#FFF0F0F0</Color>
    <Color x:Key="SecondaryForegroundColor">#FFF0F0F0</Color>
    <Color x:Key="ReadOnlyForegroundColor">#FFB0B0B0</Color>
    <Color x:Key="PrimaryAccentColor">#FF0078D4</Color>
    <Color x:Key="SecondaryAccentColor">#FF5B7EC7</Color>
    <Color x:Key="BorderColor">#FF454545</Color>

    <!-- Status Brushes -->
    <SolidColorBrush x:Key="SuccessBrush" Color="#FF36B536" />
    <SolidColorBrush x:Key="ErrorBrush" Color="#FFEC4D39" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFFFC14F" />
    <SolidColorBrush x:Key="IndeterminateBrush" Color="#FFA0A0A0" />
    <SolidColorBrush x:Key="BusyBrush" Color="#FFFFB347" />

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="TertiaryBackgroundBrush" Color="{StaticResource TertiaryBackgroundColor}" />
    <SolidColorBrush x:Key="PrimaryForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="SecondaryForegroundBrush" Color="{StaticResource SecondaryForegroundColor}" />
    <SolidColorBrush x:Key="ReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="{StaticResource SecondaryAccentColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    
    <!-- Variations -->
    <SolidColorBrush x:Key="SelectedItemBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.75" />
    <SolidColorBrush x:Key="SelectedUnfocusedBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />    
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ItemPressedBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />

    <!-- ScrollBar Brushes -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="{StaticResource PrimaryAccentColor}" />    

    <!-- PropertyGrid Colors (Consolidated, only used brushes) -->
    <SolidColorBrush x:Key="PropertyGridBackgroundBrush" Color="{StaticResource PrimaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridForegroundBrush" Color="{StaticResource PrimaryForegroundColor}" />
    <SolidColorBrush x:Key="PropertyGridSecondaryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridCategoryBackgroundBrush" Color="{StaticResource SecondaryBackgroundColor}" />
    <SolidColorBrush x:Key="PropertyGridBorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="PropertyGridAccentBrush" Color="{StaticResource PrimaryAccentColor}" />
    <SolidColorBrush x:Key="PropertyGridSelectedBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" />        
    <SolidColorBrush x:Key="PropertyGridReadOnlyForegroundBrush" Color="{StaticResource ReadOnlyForegroundColor}" />    
    <SolidColorBrush x:Key="PropertyGridHoverBackgroundBrush" Color="{StaticResource PrimaryAccentColor}" Opacity="0.50" />

</ResourceDictionary>