<Application x:Class="WmiExplorer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WmiExplorer">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--  Main Theme will be loaded dynamically by ThemeManager from the Themes folder  -->

                <!--  Converters  -->
                <ResourceDictionary Source="Presentation/Converters/Converters.xaml" />

                <!--  Load modular styles  -->
                <ResourceDictionary Source="Presentation/Styles/SpacingStyles.xaml" />
                <ResourceDictionary Source="Presentation/Styles/AllStyles.xaml" />

                <!--  Control styles  -->
                <ResourceDictionary Source="Presentation/Styles/AvalonEditCompletionStyles.xaml" />
                <ResourceDictionary Source="Presentation/ColorPicker/ColorPickerTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/WmiExplorer.PropertyGrid;component/Styles/PropertyGridTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
