<Window
    x:Class="WmiExplorer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:behaviors="clr-namespace:WmiExplorer.Presentation.Behaviors"
    xmlns:controls="clr-namespace:WmiExplorer.Presentation.Controls"
    xmlns:converters="clr-namespace:WmiExplorer.Presentation.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:services="clr-namespace:WmiExplorer.Services"
    xmlns:shared="clr-namespace:WmiExplorer.Common.Shared"
    xmlns:vm="clr-namespace:WmiExplorer.Presentation.ViewModels"
    xmlns:userControls="clr-namespace:WmiExplorer.Presentation.UserControls"
    xmlns:pg="clr-namespace:WmiExplorer.Presentation.Controls.PropertyGrid"
    Title="WmiExplorer"
    Width="1280"
    Height="960"
    Background="{DynamicResource PrimaryBackgroundBrush}"
    BorderBrush="{DynamicResource BorderBrush}"
    Foreground="{DynamicResource PrimaryForegroundBrush}"
    Icon="Resources\AppIcon.ico"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <converters:BoolAndNotBoolToVisibilityConverter x:Key="BoolAndNotBoolToVisibilityConverter" />
        <converters:NotBoolAndNotBoolToVisibilityConverter x:Key="NotBoolAndNotBoolToVisibilityConverter" />
        <converters:ApplicationStateToCursorConverter x:Key="ApplicationStateToCursorConverter" />
        <converters:EnumFlagsToBooleanConverter x:Key="EnumFlagsToBooleanConverter" />
    </Window.Resources>
    <Window.Cursor>
        <Binding Converter="{StaticResource ApplicationStateToCursorConverter}" Path="CurrentApplicationState" />
    </Window.Cursor>
    <Grid Name="MainGrid">
        <Grid.RowDefinitions>
            <!--  Menu  -->
            <RowDefinition Height="Auto" />
            <!--  Application Content  -->
            <RowDefinition Height="*" />
            <!--  Status Bar  -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Menu Grid.Row="0">
            <Menu.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" />
                </ItemsPanelTemplate>
            </Menu.ItemsPanel>
            <MenuItem Header="_File">
                <MenuItem Header="Load..." />
                <MenuItem Header="Save..." />
                <MenuItem Command="{Binding ExitCommand}" Header="E_xit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Cut" />
                <MenuItem Header="Copy" />
                <MenuItem Header="Paste" />
            </MenuItem>
            <TextBlock><Hyperlink>Version</Hyperlink></TextBlock>
            <MenuItem
                x:Name="ThemeToggle"
                Margin="10,0"
                HorizontalAlignment="Right"
                Command="{Binding ToggleThemeCommand}"
                DockPanel.Dock="Right"
                Header="{Binding ThemeToggleText, Mode=OneWay}" />
        </Menu>

        <Grid Name="ApplicationContentGrid" Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel
                Grid.Row="0"
                Margin="5,0,5,0"
                VerticalAlignment="Top">
                <userControls:OptionsPanel />
            </DockPanel>
            <DockPanel Grid.Row="1" Margin="5,0,5,0">
                <Grid Name="ContentGrid">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{Binding WindowPosition.NamespacesColumnWidth, Mode=TwoWay}" />
                        <ColumnDefinition Width="Auto" />  <!-- Changed from fixed 15px to Auto -->
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="Auto" />  <!-- Changed from fixed 15px to Auto -->
                        <ColumnDefinition Width="{Binding WindowPosition.PropertyGridWidth, Mode=TwoWay}" />
                    </Grid.ColumnDefinitions>

                    <!-- Namespace View -->
                    <userControls:WmiNamespacesPane Grid.Column="0" />

                    <GridSplitter
                        Grid.Column="1"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding WindowPosition.IsNamespacesExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <TabControl Grid.Column="2">
                        <TabItem Header="Classes">
                            <!-- All the grid content has been moved to WmiClassesTab -->
                            <userControls:WmiClassesTab />
                        </TabItem>
                        <TabItem Header="Search">
                            <!-- Search View -->
                            <userControls:WmiSearchTab />
                        </TabItem>
                    </TabControl>

                    <GridSplitter
                        Grid.Column="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Stretch"
                        Visibility="{Binding WindowPosition.IsPropertyGridExpanded, Converter={StaticResource BoolToVisibilityConverter}}" />

                    <!-- Property Grid with Expander -->
                    <Grid Grid.Column="4">
                        <Expander
                            Name="ExpanderPropertyGrid"
                            Padding="0,3,0,0"
                            BorderThickness="0"
                            ExpandDirection="Left"
                            Style="{StaticResource VerticalHeaderExpanderStyle}"
                            IsExpanded="{Binding WindowPosition.IsPropertyGridExpanded, Mode=TwoWay}">
                            <Expander.Header>
                                <Border Width="25">
                                    <TextBlock
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Text="Properties">
                                        <TextBlock.LayoutTransform>
                                            <RotateTransform Angle="90" />
                                        </TextBlock.LayoutTransform>
                                    </TextBlock>
                                </Border>
                            </Expander.Header>
                            <Expander.Content>
                                <Grid>
                                    <!-- Border around both header and property grid -->
                                    <Border
                                        BorderBrush="{DynamicResource PrimaryAccentBrush}"
                                        BorderThickness="0"
                                        CornerRadius="3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>

                                            <!-- Header for selected object -->
                                            <Border
                                                Grid.Row="0"
                                                Background="{DynamicResource PrimaryAccentBrush}"
                                                BorderThickness="0"
                                                Padding="10,5"
                                                Margin="0">
                                                <TextBlock
                                                    Text="{Binding SelectedObject.ActualObject.Path.RelativePath}"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource PrimaryForegroundBrush}"
                                                    Background="{DynamicResource PrimaryAccentBrush}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>

                                            <pg:CustomPropertyGrid
                                                Grid.Row="1"
                                                x:Name="PropertyGrid"
                                                Background="{DynamicResource PropertyGridBackgroundBrush}"
                                                NameColumnWidth="150"
                                                ShowSearchBox="True"
                                                EnableVirtualization="True"
                                                SelectedObject="{Binding SelectedObject.ActualObject, Mode=OneWay}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Expander.Content>
                        </Expander>
                    </Grid>
                </Grid>
            </DockPanel>
        </Grid>
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock
                    x:Name="StatusBarText"
                    Margin="5,0"
                    Text="{Binding CurrentApplicationState.Message}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Margin="0,0,5,0" Orientation="Horizontal">
                    <!-- <TextBlock Text="{Binding ComputerName}" Margin="0,0,8,0" VerticalAlignment="Center" /> -->
                    <userControls:StatusIndicator DataContext="{Binding}" ToolTip="{Binding CurrentApplicationState.Message}" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>